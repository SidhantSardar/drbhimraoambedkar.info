---
import { NAV, SITE, url } from '../lib/site';
import { getLang, pathIn } from '../i18n';
const lang = getLang(Astro);
const mr = lang === 'mr';
const bilingual = process.env.SKIP_MARATHI !== '1';
const current = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = (href: string) => {
  const target = pathIn(base + href, lang);
  return current === target || (href !== '/' && current.startsWith(target));
};
---
<header class="site-header" id="top">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label={mr ? `${SITE.mrName} — मुख्यपृष्ठ` : `${SITE.name} — home`}>
      <img class="brand-mark" src={url('/images/brand/reader-mark.svg')} alt="" width="36" height="36" />
      <span class="brand-name">{mr ? SITE.mrName : SITE.name}<small>{mr ? SITE.mrTagline : SITE.tagline}</small></span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {NAV.map((g) => g.items ? (
          <li class="has-menu">
            <details>
              <summary class={g.items.some((i) => here(i.href)) ? 'active' : undefined}>{mr ? g.mr : g.label}</summary>
              <ul class="menu">
                {g.items.filter((i) => !(mr && i.enOnly)).map((i) => (
                  <li><a href={url(i.href)} aria-current={here(i.href) ? 'page' : undefined}>{mr ? i.mr : i.label}{i.hint && <small>{mr ? i.mrHint : i.hint}</small>}</a></li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li><a href={url(g.href!)} aria-current={here(g.href!) ? 'page' : undefined}>{mr ? g.mr : g.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      {bilingual && <div class="lang-switch" role="group" aria-label={mr ? 'भाषा' : 'Language'}>
        <a href={pathIn(current, 'en')} hreflang="en" lang="en" data-lang-switch aria-current={mr ? undefined : 'true'}>EN</a>
        <a href={/\/chat\/?$/.test(current) ? pathIn('/', 'mr') : pathIn(current, 'mr')} hreflang="mr" lang="mr" data-lang-switch aria-current={mr ? 'true' : undefined}>मराठी</a>
      </div>}
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="nav-toggle" aria-label={mr ? 'मेनू उघडा' : 'Open menu'} data-open={mr ? 'मेनू बंद करा' : 'Close menu'} data-closed={mr ? 'मेनू उघडा' : 'Open menu'}>
        <span class="nav-ico" aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var btn = document.getElementById('nav-toggle');
    btn.addEventListener('click', function () {
      var open = document.body.classList.toggle('nav-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? btn.dataset.open : btn.dataset.closed);
      btn.querySelector('.nav-ico').textContent = open ? '✕' : '☰';
    });
    var menus = document.querySelectorAll('.site-nav details');
    var desktop = window.matchMedia('(min-width: 1080px)');
    // Only one dropdown open at a time; close on outside click or Escape (desktop).
    menus.forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open) menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener('click', function (e) {
      if (!desktop.matches) return;
      menus.forEach(function (d) { if (!d.contains(e.target)) d.open = false; });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      menus.forEach(function (d) { d.open = false; });
      if (document.body.classList.contains('nav-open')) btn.click();
    });
    // Mouse users: menus open on hover and close shortly after the pointer leaves.
    var hover = window.matchMedia('(hover: hover) and (min-width: 1080px)');
    menus.forEach(function (d) {
      var li = d.parentElement, timer = 0;
      li.addEventListener('mouseenter', function () { if (!hover.matches) return; clearTimeout(timer); d.open = true; });
      li.addEventListener('mouseleave', function () { if (!hover.matches) return; timer = setTimeout(function () { d.open = false; }, 200); });
      // A mouse click on an already-open (hovered) menu keeps it open; keyboard Enter still toggles it.
      d.querySelector('summary').addEventListener('click', function (e) { if (hover.matches && e.detail > 0) { e.preventDefault(); d.open = true; } });
    });
    // Light design: keep the Safari toolbar tint matched to the page while scrolling.
    if (document.documentElement.dataset.skin === 'light') {
      var lastY = window.scrollY, ticking = false, body = document.body;
      var onScroll = function () {
        var y = window.scrollY, d = y - lastY;
        // The header stays on screen at all times (it used to slide away while reading down).
        body.classList.remove('hdr-hidden');
        if (Math.abs(d) > 6 || y < 80) lastY = y;
        // Safari's bottom toolbar takes its tint from the page background: match it to the section at the bottom edge
        var el = document.elementFromPoint(window.innerWidth / 2, window.innerHeight - 2), bg = '';
        while (el && el !== document.documentElement) {
          var c = getComputedStyle(el).backgroundColor;
          if (c && c !== 'transparent' && !/rgba\([^)]*,\s*0\)$/.test(c)) { bg = c; break; }
          el = el.parentElement;
        }
        document.documentElement.style.backgroundColor = bg || '';
        ticking = false;
      };
      window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
      onScroll();
    }
    // On phones the menu is an accordion: only the section holding the current page starts open.
    if (!desktop.matches) menus.forEach(function (d) { d.open = !!d.querySelector('summary.active'); });
  })();
</script>
