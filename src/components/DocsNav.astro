---
// Left-hand navigation of the documentation-style reader: the volume's parts, chapters and sub-parts.
import { tocOf, coverOf, type Volume } from '../lib/library';
import { url } from '../lib/site';

interface Props { vol: Volume; current?: string }
const { vol, current } = Astro.props;
const chapters = tocOf(vol);

// Group consecutive chapters under their printed Part / Section / Book heading.
type G = { name: string; items: typeof chapters };
const groups: G[] = [];
for (const c of chapters) {
  const last = groups[groups.length - 1];
  if (last && last.name === c.group) last.items.push(c);
  else groups.push({ name: c.group, items: [c] });
}
const isCurrent = (c: (typeof chapters)[number]) => c.parts.some((p) => p.slug === current);
---
<aside class="docs-nav" aria-label={`Contents of ${vol.label}`}>
  <a class="docs-vol" href={url(`/library/${vol.id}/`)}>
    <img src={url(coverOf(vol))} alt="" width="56" height="86" loading="lazy" />
    <span><small>{vol.label}</small>{vol.title}</span>
  </a>
  <label class="docs-filter">
    <span class="visually-hidden">Filter chapters</span>
    <input type="search" placeholder="Filter chapters…" data-docs-filter />
  </label>
  <nav>
    {groups.map((g) => (
      <div class="docs-group">
        {g.name && <p class="docs-group-name">{g.name}</p>}
        <ul>
          {g.items.map((c) => (
            <li class:list={[{ open: isCurrent(c) }]} data-title={c.title.toLowerCase()}>
              {c.parts.length === 1 ? (
                <a href={url(`/library/${vol.id}/${c.parts[0].slug}/`)} aria-current={c.parts[0].slug === current ? 'page' : undefined}>{c.title}</a>
              ) : (
                <details open={isCurrent(c)}>
                  <summary>{c.title}</summary>
                  <ul>
                    {c.parts.map((p) => (
                      <li><a href={url(`/library/${vol.id}/${p.slug}/`)} aria-current={p.slug === current ? 'page' : undefined}>{p.title} <small>pp. {p.start}–{p.end}</small></a></li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>
