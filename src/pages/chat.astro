---
// "Ask in his words": a chat that answers only with passages from Writings and Speeches, exactly as printed.
// Nothing is generated. It runs in the browser on the site's own search index (Pagefind): no server, no key, no cost.
import Base from '../layouts/Base.astro';
import { getLang, translator } from '../i18n';
const lang = getLang(Astro);
const t = translator(lang);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const starters = lang === 'mr'
  ? ['उच्च शिक्षणाबद्दल ते काय म्हणाले?', 'जातिव्यवस्थेचा नाश का आवश्यक आहे?', 'भाषिक राज्यांबद्दल त्यांचे मत काय?', 'स्वतंत्र मतदारसंघ का हवे होते?']
  : ['What did he say about education for the poor?', 'Why must caste be annihilated?', 'What is democracy?', 'What did he say about women?'];
const L = {
  intro: t('Passages from the volumes on this, word for word:', 'यावर खंडांतील परिच्छेद, शब्दशः:'),
  who: t('The volumes also record debates and editors’ notes, so open the page to see who is speaking.', 'खंडांमध्ये चर्चा आणि संपादकीय टिपाही आहेत, म्हणून कोण बोलत आहे ते पाहण्यासाठी पान उघडा.'),
  none: t('I found nothing in the volumes for that. Try simpler words, or a word he would have used, like “education”, “caste” or “franchise”.', 'खंडांमध्ये यासाठी काही सापडले नाही. सोपे शब्द वापरून पाहा, जसे “शिक्षण”, “जात” किंवा “मताधिकार”.'),
  searching: t('Searching the volumes…', 'खंडांमध्ये शोधत आहे…'),
  unavailable: t('Search is not available in this preview. It works on the published site.', 'या पूर्वदर्शनात शोध उपलब्ध नाही. प्रकाशित संकेतस्थळावर तो चालतो.'),
  page: t('Page', 'पृष्ठ'),
  pdfPage: t('PDF p.', 'PDF पृ.'),
  read: t('Read the full page', 'पूर्ण पान वाचा'),
  pdf: t('Official PDF ↗', 'अधिकृत PDF ↗'),
  original: t('Original English', 'मूळ इंग्रजी'),
  listen: t('Listen', 'ऐका'),
  stop: t('Stop', 'थांबवा'),
  you: t('You', 'तुम्ही'),
  them: t('From the volumes', 'खंडांमधून'),
  listening: t('Listening… speak your question', 'ऐकत आहे… तुमचा प्रश्न बोला'),
  micNo: t('Voice input is not supported in this browser. Try Chrome, Edge or Safari.', 'या ब्राउझरमध्ये आवाजाने प्रश्न विचारता येत नाही. Chrome, Edge किंवा Safari वापरून पाहा.'),
};
---
<Base footer={false} title={t('Ask in his words', 'त्यांच्याच शब्दांत विचारा')} description={t('Ask a question and read the answer in Dr. Ambedkar’s own words: passages from Writings and Speeches, exactly as printed, with the page and the official PDF. Nothing is generated.', 'प्रश्न विचारा आणि उत्तर डॉ. आंबेडकरांच्याच शब्दांत वाचा: लेखन आणि भाषणे मधील परिच्छेद, जसे छापले तसे, पान आणि अधिकृत PDF सह. काहीही नव्याने लिहिलेले नाही.')}>
  <div class="chat-wrap" data-pagefind-ignore="all">
    <header class="chat-head">
      <span class="eyebrow">{t('Writings and Speeches', 'लेखन आणि भाषणे')}</span>
      <h1>{t('Ask in his words', 'त्यांच्याच शब्दांत विचारा')}</h1>
      <p class="chat-sub">{t('Every reply is a passage from the 17 volumes, exactly as printed, with its page and the official PDF. Nothing is written by AI, so nothing is put in his mouth.', 'प्रत्येक उत्तर 17 खंडांतील परिच्छेद आहे, जसे छापले तसे, त्याच्या पानासह आणि अधिकृत PDF सह. काहीही AI ने लिहिलेले नाही, म्हणून त्यांच्या तोंडी कोणतेही शब्द घातले जात नाहीत.')}</p>
      {lang === 'mr' && <p class="chat-note">मराठी प्रश्नांसाठी आतापर्यंत अनुवादित खंड (1 आणि 2) शोधले जातात. उर्वरित खंडांसाठी इंग्रजीत विचारा.</p>}
    </header>

    <div class="chat-log" id="chat-log" aria-live="polite">
      <div class="msg bot">
        <span class="who">{L.them}</span>
        <div class="bubble">
          <p>{t('Ask anything about his writings and speeches. You can type, or tap the microphone and speak.', 'त्यांच्या लेखन आणि भाषणांबद्दल काहीही विचारा. टाइप करा, किंवा मायक्रोफोन दाबून बोला.')}</p>
          <div class="starters">
            {starters.map((s) => <button type="button" class="starter" data-q={s}>{s}</button>)}
          </div>
        </div>
      </div>
    </div>

    <form class="composer" id="composer" autocomplete="off">
      <label class="visually-hidden" for="chat-q">{t('Your question', 'तुमचा प्रश्न')}</label>
      <button type="button" class="mic" id="mic" aria-label={t('Ask by voice', 'आवाजाने विचारा')} title={t('Ask by voice', 'आवाजाने विचारा')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <input id="chat-q" name="q" type="text" enterkeyhint="send" placeholder={t('Ask a question…', 'प्रश्न विचारा…')} />
      <button type="submit" class="send" aria-label={t('Send', 'पाठवा')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l16-8-6 16-2.5-6.5z" /></svg>
      </button>
    </form>
  </div>

  <script is:inline define:vars={{ base, L, lang }}>
    (function () {
      var log = document.getElementById('chat-log');
      var form = document.getElementById('composer');
      var input = document.getElementById('chat-q');
      var micBtn = document.getElementById('mic');
      var pagefind = null, pageCache = {};

      var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
      var STOP = ' a an the is are was were be been of on in to for and or but with by about what which who whom whose why how when where did does do say said tell me his her he she it its this that these those dr dr. babasaheb ambedkar ambedkars bhimrao b r b.r. think thought view views opinion according must should would could can ' +
        'काय कसे का कोणते कोण की आणि व हे ही ते त्या या आहे आहेत होते होता होती म्हणाले म्हणतात म्हटले सांगितले सांगा लिहिले बद्दल विषयी संबंधी बाबत डॉ डॉ. बाबासाहेब आंबेडकर आंबेडकरांनी आंबेडकरांचे आंबेडकरांचा आंबेडकरांची यांनी त्यांनी त्यांचे त्यांचा त्यांची विचार मत आवश्यक हवे होते ';
      var termsOf = function (q) {
        return q.toLowerCase().replace(/[?!.,;:"'’“”।]/g, ' ').split(/\s+/).filter(function (w) { return w && w.length > 1 && STOP.indexOf(' ' + w + ' ') < 0; });
      };
      // each question word becomes a "concept": the word, its stem, and a few close words from his vocabulary
      var NEAR = {
        poor: ['poverty', 'lower classes', 'lowest strata', 'depressed classes', 'poorer'], poverty: ['poor'],
        education: ['educate', 'educated', 'educational', 'school', 'schools', 'college', 'colleges', 'university', 'learning'],
        women: ['woman', 'female', 'girls', 'wife', 'wives', 'marriage'], woman: ['women'],
        caste: ['castes', 'varna', 'chaturvarnya'], untouchability: ['untouchable', 'untouchables', 'depressed classes'],
        democracy: ['democratic', 'liberty', 'equality', 'fraternity'], religion: ['religious', 'dharma', 'buddhism'],
        workers: ['labour', 'labourers', 'working class'], labour: ['workers', 'labourers', 'working class'],
        'शिक्षण': ['शिक्षणा', 'शाळा', 'महाविद्यालय', 'विद्यापीठ'], 'गरीब': ['दारिद्र्य', 'गरिबी', 'खालच्या वर्ग', 'खालचे थर', 'गरिबांच्या'],
        'स्त्रिया': ['स्त्री', 'महिला', 'स्त्रियां'], 'जात': ['जाती', 'जातिव्यवस्था', 'जातिनिर्मूलन'], 'लोकशाही': ['लोकशाहीच', 'स्वातंत्र्य', 'समता', 'बंधुता']
      };
      var concepts = function (terms) {
        return terms.map(function (w) {
          var v = [w];
          if (/[ऀ-ॿ]/.test(w)) {
            var st = w.replace(/(ाबद्दल|ाविषयी|ाचे|ाचा|ाची|ाच्या|ाला|ाने|ात|ांचे|ांचा|ांची|ांच्या|ांना|ांनी|ांत|बद्दल|विषयी|चे|चा|ची|च्या|ला|ने|त|ना|नी)$/, '');
            if (st.length > 1) v.push(st);
          } else if (w.length > 4) v.push(w.replace(/(ies|es|s|ing|ed)$/, ''));
          v.forEach(function (x) { (NEAR[x] || []).forEach(function (n) { v.push(n); }); });
          return v.filter(function (x, i, a) { return x && a.indexOf(x) === i; });
        });
      };
      var flat = function (cs) { return [].concat.apply([], cs).filter(function (x, i, a) { return a.indexOf(x) === i; }); };
      async function load() {
        if (!pagefind) {
          pagefind = await import(base + 'pagefind/pagefind.js');
          await pagefind.options({ baseUrl: base, excerptLength: 50 });
          await pagefind.init();
        }
        return pagefind;
      }
      async function fetchPage(u) {
        var key = u.replace(/#.*$/, '');
        if (!pageCache[key]) pageCache[key] = fetch(key).then(function (r) { return r.text(); }).then(function (h) { return new DOMParser().parseFromString(h, 'text/html'); });
        return pageCache[key];
      }
      var count = function (text, terms) {
        var low = text.toLowerCase(), n = 0;
        terms.forEach(function (w) { if (low.indexOf(w) >= 0) n += w.length > 3 ? 2 : 1; });
        return n;
      };
      // how many of the question's concepts a passage holds (each concept counts once), plus how often
      var conceptScore = function (text, cs) {
        var low = text.toLowerCase(), hit = 0, occ = 0;
        cs.forEach(function (c) { var any = false; c.forEach(function (w) { var i = low.indexOf(w); if (i >= 0) { any = true; occ += low.split(w).length - 1; } }); if (any) hit++; });
        return { hit: hit, occ: occ };
      };
      // keep the passage verbatim; if it is very long, show the sentences around the best match
      var trim = function (text, terms) {
        if (text.length <= 900) return text;
        var parts = text.split(/(?<=[.!?।])\s+/), best = 0, bestScore = -1;
        parts.forEach(function (p, i) { var s = count(p, terms); if (s > bestScore) { bestScore = s; best = i; } });
        var a = best, b = best, len = parts[best].length;
        while (len < 650 && (a > 0 || b < parts.length - 1)) {
          if (b < parts.length - 1) { b++; len += parts[b].length; }
          if (len < 650 && a > 0) { a--; len += parts[a].length; }
        }
        return (a > 0 ? '… ' : '') + parts.slice(a, b + 1).join(' ') + (b < parts.length - 1 ? ' …' : '');
      };
      var mark = function (text, terms) {
        var safe = esc(text);
        var words = terms.slice().sort(function (x, y) { return y.length - x.length; }).map(function (w) { return w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); });
        if (!words.length) return safe;
        return safe.replace(new RegExp('(' + words.join('|') + ')', 'gi'), '<mark>$1</mark>');
      };

      async function passageFor(d, sub, cs) {
        var terms = flat(cs);
        var m = sub.url.match(/#p(\d+)$/); if (!m) return null;
        var pageNo = m[1];
        var doc = await fetchPage(sub.url).catch(function () { return null; });
        if (!doc) return null;
        var h2 = doc.getElementById('p' + pageNo); if (!h2) return null;
        var section = h2.closest('.docs-page'); if (!section) return null;
        var reader = section.querySelector('.reader:not(.reader-en)'); if (!reader) return null;
        var blocks = Array.prototype.slice.call(reader.children);
        var bi = -1, bs = -1, bh = 0;
        blocks.forEach(function (b, i) {
          if (b.classList.contains('muted') || b.textContent.trim().length < 60) return;
          var c = conceptScore(b.textContent, cs), sc = c.hit * 100 + Math.min(c.occ, 20);
          if (c.hit > 0 && sc > bs) { bs = sc; bh = c.hit; bi = i; }
        });
        if (bi < 0) return null;
        var text = blocks[bi].textContent.trim();
        var english = '';
        if (reader.getAttribute('lang') === 'mr') {
          var en = section.querySelector('.reader-en');
          if (en && en.children[bi]) english = en.children[bi].textContent.trim();
        }
        var crumbs = doc.querySelector('.docs-head h1');
        return {
          score: bs, hits: bh, text: text, english: english, lang: reader.getAttribute('lang') || 'en',
          chapter: crumbs ? crumbs.textContent.trim() : (d.meta.title || ''),
          volume: (d.filters.volume || [''])[0],
          pageLabel: h2.textContent.trim(), pdfPage: pageNo,
          url: sub.url, pdf: d.meta.pdf ? d.meta.pdf + '#page=' + pageNo : ''
        };
      }

      var addMsg = function (who, html) {
        var el = document.createElement('div');
        el.className = 'msg ' + who;
        el.innerHTML = '<span class="who">' + (who === 'me' ? L.you : L.them) + '</span><div class="bubble">' + html + '</div>';
        log.appendChild(el);
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return el;
      };

      async function ask(q, byVoice) {
        q = q.trim(); if (!q) return;
        addMsg('me', '<p>' + esc(q) + '</p>');
        var wait = addMsg('bot', '<p class="muted">' + L.searching + '</p>');
        var pf;
        try { pf = await load(); } catch (e) { wait.querySelector('.bubble').innerHTML = '<p>' + L.unavailable + '</p>'; return; }
        var terms = termsOf(q), cs = concepts(terms), all = flat(cs);
        var res = await pf.search(terms.length ? terms.join(' ') : q, { filters: { collection: 'Writings and Speeches' } });
        var top = await Promise.all(res.results.slice(0, 14).map(function (r) { return r.data(); }));
        var cands = [];
        top.forEach(function (d) { (d.sub_results || []).filter(function (s) { return /#p\d+$/.test(s.url); }).slice(0, 3).forEach(function (s) { cands.push({ d: d, s: s }); }); });
        var found = (await Promise.all(cands.slice(0, 24).map(function (c) { return passageFor(c.d, c.s, cs); }))).filter(Boolean);
        // keep passages that hold the most of the question's ideas; one per page; at most five
        var best = found.reduce(function (m, p) { return Math.max(m, p.hits); }, 0);
        var floor = cs.length > 1 ? Math.max(1, Math.min(best, 2)) : 1;
        var seen = {}, picks = [];
        found.forEach(function (p, i) { p.rank = i; });
        found.filter(function (p) { return p.hits >= floor; })
          .sort(function (a, b) { return b.score - a.score || a.rank - b.rank; })
          .forEach(function (p) { var k = p.url.replace(/#.*$/, '') + '#' + p.pdfPage; if (!seen[k] && picks.length < 5) { seen[k] = 1; picks.push(p); } });
        if (!picks.length) { wait.querySelector('.bubble').innerHTML = '<p>' + L.none + '</p>'; return; }
        var html = '<p class="intro">' + L.intro + '</p>' + picks.map(function (p, i) {
          return '<figure class="passage">' +
            '<blockquote lang="' + p.lang + '">' + mark(trim(p.text, all), all) + '</blockquote>' +
            (p.english ? '<details class="orig"><summary>' + L.original + '</summary><blockquote lang="en">' + esc(trim(p.english, all)) + '</blockquote></details>' : '') +
            '<figcaption><span class="src">' + esc(p.volume) + ' · ' + esc(p.chapter) + ' · ' + esc(p.pageLabel) + (/pdf/i.test(p.pageLabel) ? '' : ' (' + L.pdfPage + ' ' + p.pdfPage + ')') + '</span>' +
            '<span class="links"><a href="' + esc(p.url) + '">' + L.read + '</a>' + (p.pdf ? ' · <a href="' + esc(p.pdf) + '" target="_blank" rel="noopener noreferrer">' + L.pdf + '</a>' : '') + '</span></figcaption>' +
            '</figure>';
        }).join('') + '<p class="who-note">' + L.who + '</p><button type="button" class="say"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="3" y="13" width="5" height="7" rx="1.5"/><rect x="16" y="13" width="5" height="7" rx="1.5"/></svg><span>' + L.listen + '</span></button>';
        var bubble = wait.querySelector('.bubble');
        bubble.innerHTML = html;
        var sayBtn = bubble.querySelector('.say');
        var items = [{ text: L.intro, lang: lang }].concat(picks.map(function (p) { return { text: trim(p.text, all), lang: p.lang }; }));
        sayBtn.addEventListener('click', function () { speaking === sayBtn ? stopSpeaking() : speak(items, sayBtn); });
        if (byVoice) speak(items, sayBtn);
      }

      /* ---------- speaking the passages: device voices, a natural male voice first ---------- */
      var synth = window.speechSynthesis, speaking = null;
      var score = function (v) {
        var n = (v.name || '') + ' ' + (v.voiceURI || ''), s = 0;
        if (/natural|neural|online|premium|enhanced/i.test(n)) s += 20;
        if (/\b(prabhat|manohar|madhur|rishi|ravi|hemant|aaron|daniel|arthur|male)\b/i.test(n)) s += 30;
        if (/\b(neerja|aarohi|swara|lekha|kalpana|heera|veena|female|samantha|karen|moira|tessa)\b/i.test(n)) s -= 15;
        if (/-IN$/i.test(v.lang)) s += 5;
        return s;
      };
      var voiceFor = function (l) {
        if (!synth) return null;
        var all = synth.getVoices(), mine = all.filter(function (v) { return new RegExp('^' + l, 'i').test(v.lang); });
        if (!mine.length && l === 'mr') mine = all.filter(function (v) { return /^hi/i.test(v.lang); });
        return mine.sort(function (a, b) { return score(b) - score(a); })[0] || null;
      };
      var stopSpeaking = function () {
        if (synth) synth.cancel();
        if (speaking) { speaking.classList.remove('on'); speaking.querySelector('span').textContent = L.listen; }
        speaking = null;
      };
      var speak = function (items, btn) {
        if (!synth || !window.SpeechSynthesisUtterance) return;
        stopSpeaking(); speaking = btn; btn.classList.add('on'); btn.querySelector('span').textContent = L.stop;
        var queue = [];
        items.forEach(function (it) {
          (it.text.match(/[^.!?।]+[.!?।]*\s*/g) || [it.text]).forEach(function (c) { if (c.trim()) queue.push({ text: c, lang: it.lang }); });
        });
        var i = 0;
        var next = function () {
          if (speaking !== btn) return;
          if (i >= queue.length) { stopSpeaking(); return; }
          var it = queue[i++], u = new SpeechSynthesisUtterance(it.text), v = voiceFor(it.lang);
          u.lang = v ? v.lang : (it.lang === 'mr' ? 'mr-IN' : 'en-IN'); if (v) u.voice = v;
          u.onend = next; u.onerror = function (e) { if (e.error !== 'interrupted' && e.error !== 'canceled') next(); };
          synth.speak(u);
        };
        next();
      };
      if (synth && synth.onvoiceschanged !== undefined) synth.addEventListener('voiceschanged', function () {});
      window.addEventListener('pagehide', function () { if (synth) synth.cancel(); });

      /* ---------- asking by voice ---------- */
      var Rec = window.SpeechRecognition || window.webkitSpeechRecognition, rec = null, heard = '';
      micBtn.addEventListener('click', function () {
        if (!Rec) { addMsg('bot', '<p>' + L.micNo + '</p>'); return; }
        if (rec) { rec.stop(); return; }
        stopSpeaking();
        rec = new Rec(); rec.lang = lang === 'mr' ? 'mr-IN' : 'en-IN'; rec.interimResults = true; rec.maxAlternatives = 1;
        heard = ''; micBtn.classList.add('on'); input.value = ''; input.placeholder = L.listening;
        rec.onresult = function (e) { heard = Array.prototype.map.call(e.results, function (r) { return r[0].transcript; }).join(' '); input.value = heard; };
        rec.onend = function () { micBtn.classList.remove('on'); input.placeholder = ''; rec = null; if (heard.trim()) { input.value = ''; ask(heard, true); } };
        rec.onerror = function () { micBtn.classList.remove('on'); rec = null; };
        rec.start();
      });

      form.addEventListener('submit', function (e) { e.preventDefault(); var q = input.value; input.value = ''; ask(q, false); });
      log.addEventListener('click', function (e) { var b = e.target.closest('.starter'); if (b) ask(b.dataset.q, false); });
      var start = new URLSearchParams(location.search).get('q'); if (start) ask(start, false);
    })();
  </script>
</Base>

<style is:global>
