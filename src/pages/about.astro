---
import Base from '../layouts/Base.astro';
import { url, SITE, SHOW_NEWS, mailto, FEEDBACK_FORM } from '../lib/site';
import { getLang, translator } from '../i18n';
const lang = getLang(Astro);
const t = translator(lang);
const guide = `${SITE.repoUrl}/blob/main/i18n/marathi-style-guide.md`;
---
<Base title={t('About', 'आमच्याविषयी')} description={t("Who is building Prabuddha Pathak and why: an Ambedkarite effort to gather all of Dr. B. R. Ambedkar's work and resources in one public place.", 'प्रबुद्ध पाठक कोण आणि का बनवत आहे: डॉ. बाबासाहेब आंबेडकर यांचे सर्व कार्य आणि साधने एकाच सार्वजनिक ठिकाणी आणण्याचा आंबेडकरवादी प्रयत्न.')}>
  <div class="narrow section">
    <span class="eyebrow">{t('About', 'आमच्याविषयी')}</span>
    <h1>{t('Why I am building this', 'मी हे का बनवत आहे')}</h1>

    {lang === 'mr' ? (
      <div class="prose">
        <p class="lede">मी <strong>सिद्धांत सरदार</strong> — एक आंबेडकरवादी आणि वेब डेव्हलपर.</p>

        <p>बाबासाहेबांचे लेखन, भाषणे, नोंदी आणि छायाचित्रे सरकारी PDF, विद्यापीठांचे संग्रह, संग्रहालये आणि स्मारकांमध्ये विखुरलेली आहेत. भारत सरकारच्या सामाजिक न्याय आणि अधिकारिता मंत्रालयानेच ती “ग्रंथालये, स्मारके, अभिलेखागारे आणि तुटक डिजिटल स्रोतांमध्ये विखुरलेली” आहेत असे म्हटले आहे <a class="src" href="https://zaidsayyed.in/tools/sih-problem-statements/sih26096" target="_blank" rel="noopener noreferrer">SIH 2026 brief SIH26096</a>.</p>

        <p>हे संकेतस्थळ ते सर्व एकाच ठिकाणी आणते: त्यांचे संपूर्ण जीवन सोप्या भाषेत, त्यांनी लिहिलेले सर्व काही सूचीबद्ध आणि शोधण्याजोगे, आणि संविधानाचे स्पष्टीकरण — सर्वांसाठी खुले आणि मोफत. हा इतिहास कसा सांगितला जातो, यात अधिक आंबेडकरवादी दृष्टिकोनाची गरज आहे, आणि त्याची सुरुवात ही साधने एकत्र, संदर्भांसहित आणि खुली असण्यापासून होते.</p>

        <p class="about-actions"><a class="btn btn-primary" href="https://www.sidhantsardar.com/" target="_blank" rel="noopener noreferrer">माझ्याविषयी आणि माझ्या कामाविषयी →</a> <a class="btn btn-ghost" href="#feedback">संपर्क करा ↓</a></p>

        <h2>हे संकेतस्थळ कसे काम करते</h2>
        <ul>
          <li><strong>प्रत्येक तथ्याला संदर्भ आहे.</strong> क्रमांकित टिपा नेमक्या दस्तऐवजाकडे किंवा पुस्तकाकडे नेतात, आणि मूळ स्रोतांना प्राधान्य दिले जाते: त्यांचे स्वतःचे शब्द, संविधान सभेतील चर्चा आणि विद्यापीठांचे संग्रह.</li>
          <li><strong>प्रामाणिकपणा.</strong> बनावट अवतरणे नाहीत. एखाद्या तारखेबद्दल किंवा तपशिलाबद्दल स्रोतांमध्ये मतभेद असल्यास आम्ही तसे स्पष्ट सांगतो आणि प्रत्येक स्रोत दाखवतो.</li>
          <li><strong>अर्थ न बदलणारा मराठी अनुवाद.</strong> पहिला मसुदा AI (Claude) च्या मदतीने, एका <a href={guide} target="_blank" rel="noopener noreferrer">सार्वजनिक अनुवाद-मार्गदर्शिकेनुसार</a> तयार केला जातो: काहीही वगळायचे नाही, काहीही जोडायचे नाही, त्यांची धार कमी करायची नाही. प्रत्येक पानासोबत मूळ इंग्रजी मजकूर आणि अधिकृत PDF एका क्लिकवर दिसते.</li>
          <li><strong>खुले आणि दुरुस्त करता येण्याजोगे.</strong> संशोधनाच्या नोंदी <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a> वर सार्वजनिक आहेत आणि कोणीही <a href={url('/contribute/')}>दुरुस्ती सुचवू</a> शकते.</li>
        </ul>

        {SHOW_NEWS && <>
          <h2>या संकेतस्थळावरील बातम्या</h2>
          <p>बातम्या विभाग दर सहा तासांनी अनेक माध्यमांमधून जात, न्याय, संविधान आणि आंबेडकरी चळवळीविषयीच्या बातम्या गोळा करतो. प्रत्येक बातमी स्रोत म्हणून दिली जाते, आणि AI च्या मदतीने लिहिलेले सारांश तसे नेहमी नमूद केले जातात.</p>
        </>}

        <h2>या संकेतस्थळाचे रूप</h2>
        <p>येथील रेषांची नक्षी <strong>गोदना</strong> चित्रकलेपासून प्रेरित आहे — बिहारमधील मिथिला भागातील दलित (दुसाध) स्त्रियांनी त्यांच्या समाजातील गोंदणाच्या परंपरेतून निर्माण केलेली कला <a class="src" href="https://behanbox.com/2023/05/25/an-art-form-of-bihars-dalit-women-asserts-its-unique-identity/" target="_blank" rel="noopener noreferrer">Behanbox</a> <a class="src" href="https://sarmaya.in/tag/godna-painting/" target="_blank" rel="noopener noreferrer">Sarmaya</a>. येथील नक्षी त्या प्रेरणेतून आम्ही स्वतः काढलेली साधी चित्रे आहेत, कोणत्याही कलाकाराच्या कामाची नक्कल नाही.</p>

        <h2>प्रताधिकार आणि पुनर्वापर</h2>
        <ul>
          <li>डॉ. आंबेडकर यांनी हयातीत प्रकाशित केलेले लेखन 2017 पासून भारतात सार्वजनिक क्षेत्रात (public domain) आहे. महाराष्ट्र शासनाने प्रकाशित केलेले आणि भारत सरकारने ऑनलाइन मोफत उपलब्ध करून दिलेले <em>लेखन आणि भाषणे</em> खंड हे संकेतस्थळ मोफत, ना-नफा शिक्षणासाठी, नेहमी अधिकृत फाइल्सच्या दुव्यासह, पुनःप्रकाशित आणि अनुवादित करते.</li>
          <li>छायाचित्रे आणि दस्तऐवजांचे परवाने त्यांच्यासोबत दिलेले आहेत. या संकेतस्थळासाठी लिहिलेला मूळ मजकूर <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">Creative Commons BY-SA 4.0</a> परवान्याखाली उपलब्ध आहे.</li>
          <li>येथे वापरलेल्या एखाद्या गोष्टीचे हक्क तुमच्याकडे असतील आणि ती बदलावी किंवा काढावी असे वाटत असेल, तर कृपया <a href={mailto('Rights request: Prabuddha Pathak')}>{SITE.email}</a> वर ईमेल करा.</li>
        </ul>
      </div>
    ) : (
      <div class="prose">
        <p class="lede">I am <strong>Sidhant Sardar</strong> — an Ambedkarite and a web developer.</p>

        <p>Babasaheb's writings, speeches, records and photographs are spread across government PDFs, university archives, museums and memorials. India's Ministry of Social Justice and Empowerment itself describes them as "spread across libraries, memorials, archives, and fragmented digital sources" <a class="src" href="https://zaidsayyed.in/tools/sih-problem-statements/sih26096" target="_blank" rel="noopener noreferrer">SIH 2026 brief SIH26096</a>.</p>

        <p>This website brings them together in one place: his whole life told simply, everything he wrote catalogued and searchable, and the Constitution explained — open and free for everyone. We need a more Ambedkarite approach to how this history is told, and that starts with the resources being gathered, sourced and open.</p>

        <p class="about-actions"><a class="btn btn-primary" href="https://www.sidhantsardar.com/" target="_blank" rel="noopener noreferrer">More about me and my work →</a> <a class="btn btn-ghost" href="#feedback">Contact us ↓</a></p>

        <h2>How this website works</h2>
        <ul>
          <li><strong>Every fact has a source.</strong> Numbered notes lead to the exact document or book, and primary sources come first: his own words, the Constituent Assembly Debates and university archives.</li>
          <li><strong>Honest.</strong> No invented quotes. When sources disagree about a date or detail, we say so and show each one.</li>
          <li><strong>Marathi that keeps his meaning.</strong> First drafts are made with the help of AI (Claude), following a <a href={guide} target="_blank" rel="noopener noreferrer">public translation guide</a>: nothing left out, nothing added, nothing softened. Every page has the original English and the official PDF one click away.</li>
          <li><strong>Open and correctable.</strong> The research notes are public on <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>, and anyone can <a href={url('/contribute/')}>suggest a correction</a>.</li>
        </ul>

        {SHOW_NEWS && <>
          <h2>News on this website</h2>
          <p>The news section gathers reports on caste, justice, the Constitution and the Ambedkarite movement from many outlets every six hours. Every report is listed as a source, and summaries written with the help of AI are always labelled.</p>
        </>}

        <h2>The look of this website</h2>
        <p>The line patterns here are inspired by <strong>Godna</strong> painting — an art form created by Dalit (Dusadh) women of Mithila, Bihar, from the tattoo traditions of their community <a class="src" href="https://behanbox.com/2023/05/25/an-art-form-of-bihars-dalit-women-asserts-its-unique-identity/" target="_blank" rel="noopener noreferrer">Behanbox</a> <a class="src" href="https://sarmaya.in/tag/godna-painting/" target="_blank" rel="noopener noreferrer">Sarmaya</a>. The patterns are our own simple drawings in that spirit, not copies of any artist's work.</p>

        <h2>Copyright and reuse</h2>
        <ul>
          <li>The works Dr. Ambedkar published in his lifetime have been in the public domain in India since 2017. The <em>Writings and Speeches</em> volumes, published by the Government of Maharashtra and made freely available online by the Government of India, are reproduced and translated here for free, non-commercial education, always linking to the official files.</li>
          <li>Photographs and documents keep their own licences, shown with each one. Original text written for this website is shared under <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">Creative Commons BY-SA 4.0</a>.</li>
          <li>If you hold rights to something used here and want it changed or removed, please email <a href={mailto('Rights request: Prabuddha Pathak')}>{SITE.email}</a>.</li>
        </ul>
      </div>
    )}

    <section id="feedback" class="prose feedback">
      <h2>{t('Contact and feedback', 'संपर्क आणि अभिप्राय')}</h2>
      <p>{t('Send a comment, a correction, a source or a question. No sign-in needed, and your message is not published.', 'अभिप्राय, दुरुस्ती, संदर्भ किंवा प्रश्न पाठवा. साइन इन करण्याची गरज नाही, आणि तुमचा संदेश प्रसिद्ध केला जात नाही.')}</p>
      <div class="callout feedback-box" data-form-src={FEEDBACK_FORM.embed} data-form-title={t('Feedback form', 'अभिप्राय फॉर्म')}>
        <button class="btn btn-primary" type="button">{t('Open the feedback form', 'अभिप्राय फॉर्म उघडा')}</button>
        <p class="muted">{t('The form is a Google Form and loads only when you press the button.', 'हा Google Form आहे, आणि बटण दाबल्यावरच तो लोड होतो.')}</p>
      </div>
      <p class="muted feedback-note">{t('Form not working?','फॉर्म चालत नाही?')} <a href={FEEDBACK_FORM.url} target="_blank" rel="noopener noreferrer">{t('Open it in a new tab', 'तो नवीन टॅबमध्ये उघडा')}</a> {t('or email', 'किंवा')} <a href={mailto()}>{SITE.email}</a>{t('.', ' वर ईमेल करा.')}</p>
    </section>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-form-src]').forEach(function (box) {
      box.querySelector('button').addEventListener('click', function () {
        var frame = document.createElement('iframe');
        frame.src = box.dataset.formSrc;
        frame.title = box.dataset.formTitle;
        frame.className = 'feedback-frame';
        box.replaceWith(frame);
      });
    });
  </script>
</Base>

<style>
  .about-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .feedback { margin-top: 48px; scroll-margin-top: 96px; }
  .feedback-box { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .feedback-box p { margin: 0; font-size: 0.88rem; }
  .feedback .feedback-note { margin-top: 12px; font-size: 0.9rem; }
  /* Heights measured from the form itself: about 1270px at the page's full width, 1570px on a phone. */
  .feedback :global(.feedback-frame) { display: block; width: 100%; height: 1290px; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  @media (max-width: 640px) { .feedback :global(.feedback-frame) { height: 1600px; } }
</style>
