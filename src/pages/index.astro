---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import FilmGrain from '../components/FilmGrain.astro';
import { url, SHOW_NEWS } from '../lib/site';
import { chapters, themes, images, loadJSON, type Img, type Work, type Speech } from '../lib/data';
import { originalFor, credit, inLang } from '../lib/images-core.mjs';
import { volumes, leafForPage, volLabelIn } from '../lib/library';
import { SHELF_BOOKS, EDITION, bookHref } from '../lib/books';
import { loadNews, mixed, catOf as category, thumbFor, fallbackFor, ONERROR, isHindi, cleanTitle } from '../lib/news';
import { getLang, translator } from '../i18n';
const lang = getLang(Astro);
const t = translator(lang);
const catOf = (s: { category: string }) => category(s, lang);

const life = await chapters(lang);
const imgs = images(lang);
const byId = (id: string) => imgs.find((i) => i.id === id) as Img | undefined;

const heroImg = byId('ambedkar-portrait-classic');
const heroPhoto = byId('ambedkar-bhawan-delhi-conference-1951');
const factImg = { events: byId('twenty-two-vows-deekshabhoomi-1956'), works: byId('annihilation-of-caste-first-edition'), speeches: byId('yeola-speech-1935'), newspapers: byId('mooknayak-bahishkrit-bharat-mastheads') };

const pages = volumes().reduce((s, v) => s + v.pages, 0);
const allWorks = loadJSON<Work[]>('works', []);
const works = allWorks.length;
const newspapers = allWorks.filter((w: any) => w.type === 'journal').length;
const speeches = loadJSON<Speech[]>('speeches', []).length;
// Key dates across the life story, themes and the Constitution — the timeline's events, de-duplicated.
const eventKeys = new Set<string>();
for (const c of [...(await chapters()), ...(await themes())]) for (const k of c.data.keyDates) eventKeys.add(`${k.date}|${k.label.toLowerCase().replace(/[^a-z0-9]/g, '')}`);
for (const k of loadJSON<any>('constitution', {}).timeline || []) eventKeys.add(`${k.date}|${String(k.label).toLowerCase().replace(/[^a-z0-9]/g, '')}`);
const events = eventKeys.size;
const coverVol1 = url('/images/covers/volume-1.jpg');

// ---------- "Inside the volumes": his books, speeches and newspapers, each opening where it sits in the volumes ----------
const volById = Object.fromEntries(volumes().map((v) => [v.id, v]));
const volKey = (s: string) => 'volume-' + s.toLowerCase().replace(/\s*part\s*/, '-part-').replace(/\s+/g, '-');
const readAt = (b?: { volume?: string; url?: string }) => {
  const v = b?.volume ? volById[volKey(b.volume)] : undefined;
  if (!v) return null;
  const p = Number(b?.url?.match(/#page=(\d+)/)?.[1] || 0);
  const leaf = p ? leafForPage(v, p) : undefined;
  return { href: url(leaf ? `/library/${v.id}/${leaf.slug}/` : `/library/${v.id}/`), vol: volLabelIn(v, lang) };
};
const workById = Object.fromEntries(allWorks.map((w: any) => [w.id, w]));
const speechById = Object.fromEntries(loadJSON<any[]>('speeches', []).map((s: any) => [s.id, s]));
type Shelf = { id: string; title: string; year: string; desc: string; img?: Img; href: string; where: string; edition?: string };
const BOOKS = SHELF_BOOKS;
const SPEECHES: [string, string, string, string, string, string, string][] = [
  ['mahad-satyagraha-december-1927', 'chavdar-tale-mahad-1927', 'Mahad Satyagraha', 'महाड सत्याग्रह', '1927', 'For the right to drink from a public water tank.', 'सार्वजनिक तळ्याचे पाणी पिण्याच्या हक्कासाठी.'],
  ['yeola-1935', 'yeola-speech-1935', 'Yeola', 'येवला', '1935', '“I will not die a Hindu.”', '“मी हिंदू म्हणून मरणार नाही.”'],
  ['nagpur-1942-womens-conference', 'scf-womens-conference-nagpur-1942', 'Women’s conference, Nagpur', 'महिला परिषद, नागपूर', '1942', 'A community’s progress is measured by the progress of its women.', 'समाजाची प्रगती स्त्रियांच्या प्रगतीवरून मोजली जाते.'],
  ['constituent-assembly-final-1949', 'ambedkar-in-parliament-1949', 'Constituent Assembly', 'संविधान सभा', '1949', 'His final speech, with three warnings for the Republic.', 'प्रजासत्ताकासाठी तीन इशारे देणारे त्यांचे शेवटचे भाषण.'],
  ['nagpur-diksha-speech-1956', 'twenty-two-vows-deekshabhoomi-1956', 'Deekshabhoomi, Nagpur', 'दीक्षाभूमी, नागपूर', '1956', 'The speech the day after he embraced Buddhism.', 'बौद्ध धम्म स्वीकारल्यानंतरच्या दिवशीचे भाषण.'],
  ['kathmandu-1956', 'buddha-or-karl-marx-kathmandu-1956', 'Buddha or Karl Marx, Kathmandu', 'बुद्ध की कार्ल मार्क्स, काठमांडू', '1956', 'One of his last speeches, weeks before his death.', 'निधनाच्या काही आठवडे आधीचे, त्यांच्या शेवटच्या भाषणांपैकी एक.'],
];
const PAPERS: [string, string, string, string, string, string][] = [
  ['mooknayak', 'Mooknayak', 'मूकनायक', '1920', 'His first newspaper: “Leader of the Voiceless”.', 'त्यांचे पहिले वृत्तपत्र: मूकांचा नायक.'],
  ['bahishkrit-bharat', 'Bahishkrit Bharat', 'बहिष्कृत भारत', '1927', '“Excluded India”, written largely by himself.', 'बहुतांश त्यांनी स्वतः लिहिलेले पाक्षिक.'],
  ['samata', 'Samata', 'समता', '1928', 'The paper of the Social Equality League.', 'समाज समता संघाचे वृत्तपत्र.'],
  ['janata', 'Janata', 'जनता', '1930', 'The longest running of his papers.', 'त्यांचे सर्वाधिक काळ चाललेले वृत्तपत्र.'],
  ['prabuddha-bharat', 'Prabuddha Bharat', 'प्रबुद्ध भारत', '1956', 'Janata renamed, as he turned to Buddhism.', 'बौद्ध धम्माकडे वळताना जनतेचे नवे नाव.'],
];

const editionOf = (id: string, img?: Img) => (img && EDITION[id] && img.id === 'cover-' + id ? t(EDITION[id][0], EDITION[id][1]) : '');
const shelf = {
  books: BOOKS.map(([id, en, mr, year, den, dmr]): Shelf | null => {
    const at = readAt(workById[id]?.baws?.[0]);
    if (!at) return null;
    const img = byId('cover-' + id) ?? (id === 'annihilation-of-caste' ? byId('annihilation-of-caste-first-edition') : undefined);
    return { id, title: t(en, mr), year, desc: t(den, dmr), img, edition: editionOf(id, img), href: bookHref(id, volById[volKey(workById[id].baws[0].volume)]), where: at.vol };
  }).filter(Boolean) as Shelf[],
  speeches: SPEECHES.map(([id, img, en, mr, year, den, dmr]): Shelf | null => {
    const at = readAt(speechById[id]?.baws);
    if (!at) return null;
    return { id, title: t(en, mr), year, desc: t(den, dmr), img: byId(img), href: at.href, where: at.vol };
  }).filter(Boolean) as Shelf[],
  papers: PAPERS.map(([id, en, mr, year, den, dmr]): Shelf => {
    const img = byId('cover-' + id);
    // where each paper is reprinted, from the works list (Marathi volumes 19 and 20); some are not reprinted there
    const vols = [...new Set((workById[id]?.baws || []).map((b: any) => b.volume))] as string[];
    const where = vols.length > 1 ? t(`Marathi vols. ${vols.join('–')}`, `मराठी खंड ${vols.join('–')}`) : vols.length ? t(`Marathi vol. ${vols[0]}`, `मराठी खंड ${vols[0]}`) : t('About the paper', 'वृत्तपत्राविषयी');
    return { id, title: t(en, mr), year, desc: t(den, dmr), img, edition: editionOf(id, img), href: url('/works/journals/'), where };
  }),
};
const shelfTabs = [
  { key: 'books', label: t('Books', 'ग्रंथ'), n: shelf.books.length },
  { key: 'speeches', label: t('Speeches', 'भाषणे'), n: speeches },
  { key: 'papers', label: t('Newspapers', 'वृत्तपत्रे'), n: newspapers },
];

// Live updates: newest first, every kind of news represented
const news = loadNews();
const updates = mixed(news.stories, 36);
const cats = [...new Set(updates.map((n) => n.category))];
---
<Base image={heroImg ? url(heroImg.file) : undefined} description={t('Dr. B. R. Ambedkar\'s writings and speeches as readable, searchable text, word for word from the official volumes, with his life and the Constitution explained around them, in English and Marathi. A personal tribute, open to people and to AI.', 'डॉ. बाबासाहेब आंबेडकर यांचे लेखन आणि भाषणे वाचता व शोधता येणाऱ्या मजकुराच्या रूपात, अधिकृत खंडांतून शब्दशः, त्यांच्या जीवनाची आणि संविधानाची सोपी ओळख यांसह, इंग्रजी आणि मराठीत. माणसांसाठी आणि AI साठी खुली, एक वैयक्तिक आदरांजली.')}>
  <!-- 1. HERO -->
  <section class="hero-full">
    {heroImg && (
      <div class="bg" aria-hidden="true">
        <span class="bg-back"><Picture img={heroImg} eager sizes="60vw" alt="" /></span>
        <span class="bg-front"><img src={url('/images/archive/ambedkar-portrait-classic-cutout.webp')} alt="" width="1075" height="1400" loading="eager" fetchpriority="high" decoding="async" /></span>
      </div>
    )}
    <div class="hero-fx" aria-hidden="true"><span class="grid-floor"></span></div>
    {heroPhoto && (
      <div class="hero-photo" aria-hidden="true"><Picture img={heroPhoto} eager sizes="(min-width: 1000px) 130vw, 100vw" alt="" /></div>
    )}
    {heroPhoto && <canvas class="hero-grain" aria-hidden="true"></canvas>}

    <div class="hero-main">
      <span class="eyebrow">{t('1891 – 1956 · Scholar · Economist · Jurist · Reformer', '1891 – 1956 · विद्वान · अर्थशास्त्रज्ञ · कायदेपंडित · समाजसुधारक')}</span>
      {lang === 'mr' ? <h1>बाबासाहेब<br />आंबेडकर</h1> : <h1>Babasaheb<br />Ambedkar</h1>}
      <p class="hero-sub">{t('Millions know his name, but few have read his words. Here they are as text you can read, search and listen to, not scanned pages: every book, speech and newspaper, word for word from official sources, with the story of his life around them, in English and Marathi.', 'कोट्यवधी लोकांना त्यांचे नाव माहीत आहे, पण त्यांचे शब्द फारच थोड्यांनी वाचले आहेत. येथे ते स्कॅन केलेल्या पानांऐवजी वाचता, शोधता आणि ऐकता येणाऱ्या मजकुराच्या रूपात आहेत: प्रत्येक ग्रंथ, भाषण आणि वृत्तपत्र, अधिकृत स्रोतांतून शब्दशः, त्यांच्या जीवनकथेसह, इंग्रजी आणि मराठीत.')}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-beam" href="#volumes"><span>{t('Explore Volumes →', 'खंड पाहा →')}</span></a>
        <a class="btn btn-ghost" href={url('/ask/')}>{t('Ask the archive', 'संग्रहात शोधा')}</a>
      </div>
      <p class="hero-by">{t('A tribute by', 'आदरांजली —')} <a href="https://www.sidhantsardar.com/" target="_blank" rel="noopener">{t('Sidhant Sardar', 'सिद्धांत सरदार')}</a>{t(', an Ambedkarite and web developer', ', एक आंबेडकरवादी आणि वेब डेव्हलपर')} · <a href="https://www.sidhantsardar.com/" target="_blank" rel="noopener">sidhantsardar.com&nbsp;↗</a></p>
      <nav class="hero-facts" aria-label={t('The archive in numbers', 'संग्रह आकड्यांत')}>
        <a class="hf" href={url('/library/')}><span class="hf-img"><img src={coverVol1} alt="" width="360" height="540" loading="lazy" decoding="async" /></span><span class="hf-body"><span class="hf-num" data-count="17">17</span><span class="hf-label">{t('All Volumes', 'सर्व खंड')}</span><span class="hf-note">{t(`${pages.toLocaleString('en-IN')} pages of his writings`, `त्यांच्या लेखनाची ${pages.toLocaleString('en-IN')} पाने`)}</span></span></a>
        <a class="hf" href={url('/works/speeches/')}>{factImg.speeches && <span class="hf-img"><Picture img={factImg.speeches} sizes="240px" alt="" /></span>}<span class="hf-body"><span class="hf-num" data-count={speeches}>{speeches}</span><span class="hf-label">{t('Speeches', 'भाषणे')}</span><span class="hf-note">{t('major speeches, 1919–1956', 'प्रमुख भाषणे, 1919–1956')}</span></span></a>
        <a class="hf" href={url('/works/')}>{factImg.works && <span class="hf-img"><Picture img={factImg.works} sizes="240px" alt="" /></span>}<span class="hf-body"><span class="hf-num" data-count={works}>{works}</span><span class="hf-label">{t('Works', 'साहित्य')}</span><span class="hf-note">{t('books, essays, papers', 'ग्रंथ, निबंध, लेख')}</span></span></a>
        <a class="hf" href={url('/works/journals/')}>{factImg.newspapers && <span class="hf-img"><Picture img={factImg.newspapers} sizes="240px" alt="" /></span>}<span class="hf-body"><span class="hf-num" data-count={newspapers}>{newspapers}</span><span class="hf-label">{t('Newspapers', 'वृत्तपत्रे')}</span><span class="hf-note">{t('his own papers, 1920–1956', 'त्यांची स्वतःची वृत्तपत्रे, 1920–1956')}</span></span></a>
      </nav>
    </div>

    {SHOW_NEWS && updates.length > 0 && (
      <a class="ticker-mobile" href={url('/news/')}><span class="live-dot" aria-hidden="true"></span><span><strong>{t('Live updates from the movement', 'चळवळीतील थेट घडामोडी')}</strong><small>{t('See the latest news →', 'ताज्या बातम्या पाहा →')}</small></span></a>
      <button class="ticker-open" type="button" aria-controls="ticker" aria-expanded="false" data-ticker-open><span aria-hidden="true">←</span><span class="ticker-open-label"><span class="live-dot" aria-hidden="true"></span>{t('Live updates', 'थेट घडामोडी')}</span></button>
      <aside class="ticker" id="ticker" aria-label={t('Live updates', 'थेट घडामोडी')}>
        <div class="ticker-head">
          <strong><span class="live-dot" aria-hidden="true"></span>{t('Live updates', 'थेट घडामोडी')}</strong>
          <p class="ticker-sub">{t('Educate · Agitate · Organise — the movement today', 'शिका · संघर्ष करा · संघटित व्हा — आजची चळवळ')}</p>
          <div class="ticker-tags" role="group" aria-label={t('Filter updates', 'घडामोडी निवडा')}>
            <button type="button" data-tcat="all" aria-pressed="true">{t('All', 'सर्व')}</button>
            {cats.map((c) => <button type="button" data-tcat={c} aria-pressed="false" class={catOf({ category: c }).cls}>{catOf({ category: c }).label}</button>)}
          </div>
        </div>
        <div class="ticker-view" tabindex="0" aria-label={t('Scroll the updates', 'घडामोडी स्क्रोल करा')}>
          <ul class="ticker-list" style={`--dur:${updates.length * 6}s`}>
            {[...updates, ...updates].map((n, i) => (
              <li data-cat={n.category} aria-hidden={i >= updates.length ? 'true' : undefined}>
                <div class="ticker-thumb"><img src={thumbFor(n)} data-fallback={fallbackFor(n)} onerror={ONERROR} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>
                <div>
                  <span class={`cat ${catOf(n).cls}`}>{catOf(n).label}</span>
                  <a href={url(`/news/#${n.id}`)} tabindex={i >= updates.length ? -1 : undefined} lang={isHindi(n.title) ? 'hi' : 'en'}>{cleanTitle(n.title)}</a>
                  <small>{n.outlets.length > 1 ? t(`${n.outlets.length} outlets reporting`, `${n.outlets.length} माध्यमांत बातमी`) : n.outlets[0]}</small>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="ticker-foot"><span>{t('Hover to browse', 'पाहण्यासाठी पॉइंटर ठेवा')}</span><div class="ticker-actions"><button class="ticker-close" type="button" aria-label={t('Close live updates', 'थेट घडामोडी बंद करा')} data-ticker-close>{t('Close', 'बंद करा')}</button><a href={url('/news/')}>{t('All news →', 'सर्व बातम्या →')}</a></div></div>
      </aside>
    )}
    {heroImg && <p class="credit">{heroImg.caption} {credit(heroImg)} · <a href={heroImg.sourceUrl} target="_blank" rel="noopener noreferrer">{heroImg.sourceName}</a></p>}
  </section>

  <!-- 2. INSIDE THE VOLUMES: books, speeches, newspapers -->
  <section class="home-shelf" id="volumes" aria-labelledby="home-shelf-h">
    <div class="wrap">
      <div class="shelf-head" data-reveal>
        <span class="eyebrow">{t('Writings and Speeches · 17 volumes', 'लेखन आणि भाषणे · 17 खंड')}</span>
        <h2 id="home-shelf-h">{t('His books and speeches are all inside the volumes', 'त्यांचे ग्रंथ आणि भाषणे, सर्व खंडांतच आहेत')}</h2>
        <p class="lede">{t('You do not need to hunt for each book. His flagship books, his speeches and his papers are compiled, word for word, in the volumes of Dr. Babasaheb Ambedkar: Writings and Speeches. Open a cover to read it where it sits in its volume.', 'प्रत्येक ग्रंथ वेगळा शोधण्याची गरज नाही. त्यांचे प्रमुख ग्रंथ, भाषणे आणि लेख “डॉ. बाबासाहेब आंबेडकर: लेखन आणि भाषणे” या खंडांत शब्दशः संकलित आहेत. मुखपृष्ठ उघडा आणि तो ग्रंथ त्याच्या खंडातच वाचा.')}</p>
      </div>
      <div class="shelf-tabs" role="tablist" aria-label={t('What the volumes hold', 'खंडांत काय आहे')}>
        {shelfTabs.map((tab, i) => (
          <button type="button" role="tab" id={`shelf-tab-${tab.key}`} aria-controls={`shelf-${tab.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-shelf-tab={tab.key}>
            {tab.label} <span class="shelf-n">{tab.n}</span>
          </button>
        ))}
      </div>
      {shelfTabs.map((tab, i) => (
        <div class="shelf-panel" role="tabpanel" id={`shelf-${tab.key}`} aria-labelledby={`shelf-tab-${tab.key}`} hidden={i !== 0}>
          <div class="shelf-row">
          <button class="shelf-arrow prev" type="button" data-shelf-go="-1" aria-label={t('Previous', 'मागे')} disabled>←</button>
          <ul class="shelf-grid" tabindex="-1">
            {(shelf as any)[tab.key].map((b: Shelf) => (
              <li>
                <a class="shelf-card" href={b.href}>
                  <span class:list={['shelf-cover', { photo: tab.key === 'speeches' }]}>
                    {b.img ? <Picture img={b.img} sizes="(max-width: 600px) 45vw, 220px" alt="" /> : (
                      <span class="shelf-plain" aria-hidden="true"><b>{b.title}</b><small>B. R. Ambedkar · {b.year}</small></span>
                    )}
                  </span>
                  <span class="shelf-body">
                    <span class="shelf-year">{b.year}</span>
                    {b.edition && <span class="shelf-ed">{b.edition}</span>}
                    <strong>{b.title}</strong>
                    <span class="shelf-desc">{b.desc}</span>
                    <span class="shelf-vol">{tab.key === 'papers' ? b.where : t(`Read in ${b.where}`, `${b.where} मध्ये वाचा`)} <i aria-hidden="true">→</i></span>
                  </span>
                </a>
              </li>
            ))}
            {tab.key === 'speeches' && (
              <li><a class="shelf-card shelf-more" href={url('/works/speeches/')}><strong>{t(`All ${speeches} speeches`, `सर्व ${speeches} भाषणे`)}</strong><span>{t('With dates, places and where to read each one', 'तारीख, ठिकाण आणि प्रत्येक भाषण कुठे वाचावे यासह')} <i aria-hidden="true">→</i></span></a></li>
            )}
          </ul>
          <button class="shelf-arrow next" type="button" data-shelf-go="1" aria-label={t('Next', 'पुढे')}>→</button>
          </div>
          {tab.key === 'papers' && <p class="shelf-note">{t('His newspapers were in Marathi. Mooknayak, Bahishkrit Bharat and Janata are reprinted in the Marathi volumes published by the Government of Maharashtra, not in the 17 English volumes on this site.', 'त्यांची वृत्तपत्रे मराठीत होती. मूकनायक, बहिष्कृत भारत आणि जनता महाराष्ट्र शासनाच्या मराठी खंडांत पुनर्मुद्रित आहेत; या संकेतस्थळावरील 17 इंग्रजी खंडांत नाहीत.')}</p>}
        </div>
      ))}
      <div class="btn-row shelf-cta">
        <a class="btn btn-primary" href={url('/library/')}>{t('Explore all 17 volumes →', 'सर्व 17 खंड पाहा →')}</a>
