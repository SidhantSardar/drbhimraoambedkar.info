---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { url } from '../lib/site';
import { chapters, images, loadJSON, type Img, type Work, type Speech } from '../lib/data';
import { originalFor, credit, inLang } from '../lib/images-core.mjs';
import { volumes } from '../lib/library';
import { loadNews, mixed, catOf as category, thumbFor, fallbackFor, ONERROR, isHindi, cleanTitle } from '../lib/news';
import { getLang, translator } from '../i18n';
const lang = getLang(Astro);
const t = translator(lang);
const catOf = (s: { category: string }) => category(s, lang);

const life = await chapters(lang);
const imgs = images(lang);
const byId = (id: string) => imgs.find((i) => i.id === id) as Img | undefined;

const heroImg = byId('ambedkar-1950');
const bandConst = byId('constituent-assembly-first-day-1946');

const pages = volumes().reduce((s, v) => s + v.pages, 0);
const works = loadJSON<Work[]>('works', []).length;
const speeches = loadJSON<Speech[]>('speeches', []).length;

// Live updates: newest first, every kind of news represented
const news = loadNews();
const updates = mixed(news.stories, 36);
const cats = [...new Set(updates.map((n) => n.category))];
---
<Base image={heroImg ? url(heroImg.file) : undefined}>
  <!-- 1. HERO -->
  <section class="hero-full">
    {heroImg && <div class="bg"><Picture img={heroImg} eager sizes="100vw" alt="" /></div>}
    <div class="hero-fx" aria-hidden="true"><span class="grid-floor"></span></div>

    <div class="hero-main">
      <a class="status-pill" href={url('/ask/')}>
        <span class="live-dot" aria-hidden="true"></span>
        {t(`Archive online · ${pages.toLocaleString('en-IN')} pages of his writings, searchable`, `संग्रह ऑनलाइन · त्यांच्या लेखनाची ${pages.toLocaleString('en-IN')} पाने, शोधण्याजोगी`)}
        <span aria-hidden="true">→</span>
      </a>
      <span class="eyebrow">{t('1891 – 1956 · Scholar · Economist · Jurist · Reformer', '1891 – 1956 · विद्वान · अर्थशास्त्रज्ञ · कायदेपंडित · समाजसुधारक')}</span>
      {lang === 'mr' ? <h1>डॉ. भीमराव<br />रामजी आंबेडकर</h1> : <h1>Dr. Bhimrao<br />Ramji Ambedkar</h1>}
      <p class="hero-sub">{t('The boy who was not allowed to drink from the school tap became one of the most educated people of his time — and led the writing of the Constitution that promises every Indian equal dignity.', 'शाळेतील नळाचे पाणी पिण्याचीही परवानगी नसलेले ते मूल पुढे आपल्या काळातील सर्वाधिक उच्चशिक्षित व्यक्तींपैकी एक झाले — आणि प्रत्येक भारतीयाला समान प्रतिष्ठेचे वचन देणाऱ्या संविधानाच्या निर्मितीचे नेतृत्व त्यांनी केले.')}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-beam" href={url('/life/')}><span>{t('Begin his story →', 'त्यांची कथा वाचायला सुरुवात करा →')}</span></a>
        <a class="btn btn-ghost" href={url('/ask/')}>{t('Ask the archive', 'संग्रहात शोधा')}</a>
      </div>
      <dl class="hero-stats">
        <div><dt>{t('Chapters', 'प्रकरणे')}</dt><dd>{life.length}</dd></div>
        <div><dt>{t('Works', 'साहित्य')}</dt><dd>{works}</dd></div>
        <div><dt>{t('Speeches', 'भाषणे')}</dt><dd>{speeches}</dd></div>
        <div><dt>{t('Pages', 'पाने')}</dt><dd>{pages.toLocaleString('en-IN')}</dd></div>
      </dl>
    </div>

    {updates.length > 0 && (
      <aside class="ticker" aria-label={t('Live updates', 'थेट घडामोडी')}>
        <div class="ticker-head">
          <strong><span class="live-dot" aria-hidden="true"></span>{t('Live updates', 'थेट घडामोडी')}</strong>
          <p class="ticker-sub">{t('Educate · Agitate · Organise — the movement today', 'शिका · संघर्ष करा · संघटित व्हा — आजची चळवळ')}</p>
          <div class="ticker-tags" role="group" aria-label={t('Filter updates', 'घडामोडी निवडा')}>
            <button type="button" data-tcat="all" aria-pressed="true">{t('All', 'सर्व')}</button>
            {cats.map((c) => <button type="button" data-tcat={c} aria-pressed="false" class={catOf({ category: c }).cls}>{catOf({ category: c }).label}</button>)}
          </div>
        </div>
        <div class="ticker-view" tabindex="0" aria-label={t('Scroll the updates', 'घडामोडी स्क्रोल करा')}>
          <ul class="ticker-list" style={`--dur:${updates.length * 6}s`}>
            {[...updates, ...updates].map((n, i) => (
              <li data-cat={n.category} aria-hidden={i >= updates.length ? 'true' : undefined}>
                <div class="ticker-thumb"><img src={thumbFor(n)} data-fallback={fallbackFor(n)} onerror={ONERROR} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>
                <div>
                  <span class={`cat ${catOf(n).cls}`}>{catOf(n).label}</span>
                  <a href={url(`/news/#${n.id}`)} tabindex={i >= updates.length ? -1 : undefined} lang={isHindi(n.title) ? 'hi' : 'en'}>{cleanTitle(n.title)}</a>
                  <small>{n.outlets.length > 1 ? t(`${n.outlets.length} outlets reporting`, `${n.outlets.length} माध्यमांत बातमी`) : n.outlets[0]}</small>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="ticker-foot"><span>{t('Hover to browse', 'पाहण्यासाठी पॉइंटर ठेवा')}</span><a href={url('/news/')}>{t('All news →', 'सर्व बातम्या →')}</a></div>
      </aside>
    )}
    {heroImg && <p class="credit">{heroImg.caption} {credit(heroImg)} · <a href={heroImg.sourceUrl} target="_blank" rel="noopener noreferrer">{heroImg.sourceName}</a></p>}
  </section>

  <!-- 2. LIFE STORY: full-screen chapter slides; arrows bottom-right, or simply scroll on -->
  <section class="ls" id="life-story" aria-roledescription="carousel" aria-label={t('His life in chapters', 'प्रकरणांतून त्यांचे जीवन')}>
    <div class="ls-head">
      <span class="eyebrow">{t('The life story', 'जीवनकथा')}</span>
      <h2>{t(`His life, in ${life.length} chapters`, `त्यांचे जीवन, ${life.length} प्रकरणांत`)}</h2>
    </div>
    <div class="ls-track" id="ls-track" tabindex="0" aria-label={t('Chapters — use the arrow keys to move between them', 'प्रकरणे — पुढे-मागे जाण्यासाठी बाण कळा वापरा')}>
      {life.map((c, i) => {
        const img = inLang(originalFor(c.id), lang);
        const cover = img && (img.width || 0) >= 1100 && (img.width || 0) >= (img.height || 0);
        return (
          <article class={`ls-slide ${cover ? 'cover' : ''}`} aria-roledescription="slide" aria-label={`${i + 1} / ${life.length}: ${c.data.title}`} style={img ? `--img-h:${img.height}px` : undefined}>
            <span class="ls-media" aria-hidden="true">
              {img && <span class="blur"><Picture img={img} sizes="40vw" alt="" /></span>}
              {img && <span class="fg"><Picture img={img} sizes="(min-width: 900px) 60vw, 100vw" alt="" /></span>}
            </span>
            <div class="ls-cap">
              <span class="ls-k">{String(i + 1).padStart(2, '0')} · {c.data.period}</span>
              <h3><a href={url(`/life/${c.id}/`)}>{c.data.title}</a></h3>
              {c.data.summary && <p>{c.data.summary}</p>}
              <a class="ls-more" href={url(`/life/${c.id}/`)} tabindex="-1">{t('Read chapter →', 'प्रकरण वाचा →')}</a>
              {img && <p class="ls-credit">{img.caption?.split(/\.\s/)[0].replace(/\.$/, '')}. {credit(img)}</p>}
            </div>
          </article>
        );
      })}
      <article class="ls-slide ls-end" aria-roledescription="slide" aria-label={t('Explore more', 'अधिक पाहा')}>
        <div class="ls-cap">
          <span class="ls-k">{t('Keep going', 'पुढे चला')}</span>
          <h3>{t('Explore more of his life', 'त्यांच्या जीवनाविषयी अधिक')}</h3>
          <p>{t('Every date, every degree, every photograph — with sources.', 'प्रत्येक तारीख, प्रत्येक पदवी, प्रत्येक छायाचित्र — संदर्भांसह.')}</p>
          <span class="ls-links">
            <a class="btn btn-primary" href={url('/timeline/')}>{t('Timeline', 'कालपट')}</a>
            <a class="btn btn-ghost" href={url('/education/')}>{t('Educational journey', 'शैक्षणिक प्रवास')}</a>
            <a class="btn btn-ghost" href={url('/gallery/')}>{t('Gallery', 'छायाचित्रे')}</a>
          </span>
        </div>
      </article>
    </div>
    <div class="ls-ctrl">
      <span class="ls-count" aria-live="polite"><b id="ls-n">01</b> / {String(life.length).padStart(2, '0')}</span>
      <span class="ls-bar" aria-hidden="true"><i id="ls-bar"></i></span>
      <button class="ls-btn" type="button" data-ls="-1" aria-label={t('Previous chapter', 'मागील प्रकरण')} disabled>←</button>
      <button class="ls-btn" type="button" data-ls="1" aria-label={t('Next chapter', 'पुढील प्रकरण')}>→</button>
    </div>
  </section>

  <!-- 3. CONSTITUTION -->
  <section class="band">
    {bandConst && <div class="bg"><Picture img={bandConst} sizes="100vw" alt="" /></div>}
    <div class="wrap band-inner">
      <span class="eyebrow">{t('The flagship · 1946–1950', 'मुख्य विभाग · 1946–1950')}</span>
      <h2 style="max-width:14ch">{t('The Constitution of India', 'भारताचे संविधान')}</h2>
      <p class="lede" style="max-width:52ch">{t("As chairman of the Drafting Committee, he guided India's Constitution through the Constituent Assembly. Read what it promises in plain words, the articles he fought for, his speeches — and download the official text.", 'मसुदा समितीचे अध्यक्ष म्हणून त्यांनी भारताचे संविधान संविधान सभेत मार्गी लावले. ते सोप्या शब्दांत काय वचन देते, त्यांनी आग्रहाने मांडलेले अनुच्छेद आणि त्यांची भाषणे वाचा — आणि अधिकृत मजकूर डाउनलोड करा.')}</p>
      <div class="stats" style="margin:32px 0">
        <div class="stat"><strong>{t('26 Nov 1949', '26 नोव्हेंबर 1949')}</strong><span>{t('Adopted by the Constituent Assembly', 'संविधान सभेने स्वीकारले')}</span></div>
        <div class="stat"><strong>{t('26 Jan 1950', '26 जानेवारी 1950')}</strong><span>{t('Came into force — Republic Day', 'अंमलात आले — प्रजासत्ताक दिन')}</span></div>
        <div class="stat"><strong>{t('Article 17', 'अनुच्छेद 17')}</strong><span>{t('Abolished untouchability', 'अस्पृश्यता नष्ट केली')}</span></div>
        <div class="stat"><strong>{t('Article 32', 'अनुच्छेद 32')}</strong><span>{t('"The very soul of the Constitution"', '“संविधानाचा आत्मा” (त्यांच्या शब्दांत)')}</span></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/constitution/')}>{t('Explore the Constitution →', 'संविधान समजून घ्या →')}</a>
        <a class="btn btn-ghost" href={url('/constitution/#documents')}>{t('Download the official text', 'अधिकृत मजकूर डाउनलोड करा')}</a>
      </div>
    </div>
    {bandConst && <p class="credit">{bandConst.caption?.slice(0, 80)}… · {bandConst.license}</p>}
  </section>

  <script is:inline>
    (function () {
      /* ---------- Live updates: auto-scroll, hover to browse, filter by tag ---------- */
      var ticker = document.querySelector('.ticker');
      if (ticker) {
        var view = ticker.querySelector('.ticker-view');
        var list = ticker.querySelector('.ticker-list');
        var manual = false;
        var offsetNow = function () {
          var t = getComputedStyle(list).transform;
          return t && t !== 'none' ? -new DOMMatrixReadOnly(t).m42 : 0;
        };
        var toManual = function () {
          if (manual) return;
          var off = offsetNow();
          manual = true;
          list.style.animation = 'none';
          view.classList.add('manual');
          view.scrollTop = off;
        };
        var toAuto = function () {
          if (!manual) return;
          var half = list.scrollHeight / 2;
          var dur = parseFloat(list.style.getPropertyValue('--dur')) || 120;
          var off = half ? view.scrollTop % half : 0;
          manual = false;
          view.classList.remove('manual');
          view.scrollTop = 0;
          list.style.animation = '';
          list.style.animationDelay = (half ? -(off / half) * dur : 0) + 's';
        };
        ticker.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') toManual(); });
        ticker.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') toAuto(); });
        view.addEventListener('touchstart', toManual, { passive: true });
        view.addEventListener('focusin', toManual);
        var tags = ticker.querySelectorAll('[data-tcat]');
        tags.forEach(function (b) {
          b.addEventListener('click', function () {
            var c = b.dataset.tcat, shown = 0;
            tags.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
            list.querySelectorAll('li').forEach(function (li) {
              var ok = c === 'all' || li.dataset.cat === c;
              li.hidden = !ok;
              if (ok) shown++;
            });
            list.style.setProperty('--dur', Math.max(20, (shown / 2) * 6) + 's');
            list.style.animationDelay = '0s';
            view.scrollTop = 0;
          });
        });
      }

      /* ---------- Life story: arrow buttons, keys and swipe move between slides ---------- */
      var ls = document.querySelector('.ls');
      if (!ls) return;
      var track = ls.querySelector('.ls-track');
      var slides = track.querySelectorAll('.ls-slide');
      var count = slides.length - 1; // the last slide is "explore more"
      var nEl = document.getElementById('ls-n'), bar = document.getElementById('ls-bar');
      var prev = ls.querySelector('[data-ls="-1"]'), next = ls.querySelector('[data-ls="1"]');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var cur = 0;
      var index = function () { return Math.round(track.scrollLeft / Math.max(1, track.clientWidth)); };
      var show = function (i) {
        nEl.textContent = String(Math.min(i + 1, count)).padStart(2, '0');
        bar.style.transform = 'scaleX(' + (slides.length > 1 ? i / (slides.length - 1) : 1) + ')';
        prev.disabled = i <= 0;
        next.disabled = i >= slides.length - 1;
        slides.forEach(function (s, k) { s.toggleAttribute('inert', k !== i); });
      };
      var go = function (i) {
        cur = Math.max(0, Math.min(slides.length - 1, i));
        track.scrollTo({ left: cur * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
        show(cur);
      };
      prev.addEventListener('click', function () { go(cur - 1); });
      next.addEventListener('click', function () { go(cur + 1); });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
      });
      // Swipes and trackpad gestures: settle on whichever slide is showing
      var t = 0;
      track.addEventListener('scroll', function () {
        clearTimeout(t);
        t = setTimeout(function () { cur = index(); show(cur); }, 120);
      }, { passive: true });
      window.addEventListener('resize', function () { track.scrollLeft = cur * track.clientWidth; });
      show(0);
    })();
  </script>
</Base>
