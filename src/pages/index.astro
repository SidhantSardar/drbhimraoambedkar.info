---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { url } from '../lib/site';
import { chapters, images, loadJSON, type Img, type Work, type Speech } from '../lib/data';
import { originalFor, credit } from '../lib/images-core.mjs';
import { volumes } from '../lib/library';
import { loadNews, mixed, catOf, thumbFor, fallbackFor, ONERROR, isHindi, cleanTitle } from '../lib/news';

const life = await chapters();
const imgs = images();
const byId = (id: string) => imgs.find((i) => i.id === id) as Img | undefined;

const heroImg = byId('ambedkar-1950');
const bandConst = byId('constituent-assembly-first-day-1946');

const pages = volumes().reduce((s, v) => s + v.pages, 0);
const works = loadJSON<Work[]>('works', []).length;
const speeches = loadJSON<Speech[]>('speeches', []).length;

// Live updates: newest first, every kind of news represented
const news = loadNews();
const updates = mixed(news.stories, 36);
const cats = [...new Set(updates.map((n) => n.category))];
---
<Base image={heroImg ? url(heroImg.file) : undefined}>
  <!-- 1. HERO -->
  <section class="hero-full">
    {heroImg && <div class="bg"><Picture img={heroImg} eager sizes="100vw" alt="" /></div>}
    <div class="hero-fx" aria-hidden="true"><span class="grid-floor"></span></div>

    <div class="hero-main">
      <a class="status-pill" href={url('/ask/')}>
        <span class="live-dot" aria-hidden="true"></span>
        Archive online · {pages.toLocaleString('en-IN')} pages of his writings, searchable
        <span aria-hidden="true">→</span>
      </a>
      <span class="eyebrow">1891 – 1956 · Scholar · Economist · Jurist · Reformer</span>
      <h1>Dr. Bhimrao<br />Ramji Ambedkar</h1>
      <p class="hero-sub">The boy who was not allowed to drink from the school tap became one of the most educated people of his time — and led the writing of the Constitution that promises every Indian equal dignity.</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-beam" href={url('/life/')}><span>Begin his story →</span></a>
        <a class="btn btn-ghost" href={url('/ask/')}>Ask the archive</a>
      </div>
      <dl class="hero-stats">
        <div><dt>Chapters</dt><dd>{life.length}</dd></div>
        <div><dt>Works</dt><dd>{works}</dd></div>
        <div><dt>Speeches</dt><dd>{speeches}</dd></div>
        <div><dt>Pages</dt><dd>{pages.toLocaleString('en-IN')}</dd></div>
      </dl>
    </div>

    {updates.length > 0 && (
      <aside class="ticker" aria-label="Live updates">
        <div class="ticker-head">
          <strong><span class="live-dot" aria-hidden="true"></span>Live updates</strong>
          <p class="ticker-sub">Educate · Agitate · Organise — the movement today</p>
          <div class="ticker-tags" role="group" aria-label="Filter updates">
            <button type="button" data-tcat="all" aria-pressed="true">All</button>
            {cats.map((c) => <button type="button" data-tcat={c} aria-pressed="false" class={catOf({ category: c } as any).cls}>{catOf({ category: c } as any).label}</button>)}
          </div>
        </div>
        <div class="ticker-view" tabindex="0" aria-label="Scroll the updates">
          <ul class="ticker-list" style={`--dur:${updates.length * 6}s`}>
            {[...updates, ...updates].map((n, i) => (
              <li data-cat={n.category} aria-hidden={i >= updates.length ? 'true' : undefined}>
                <div class="ticker-thumb"><img src={thumbFor(n)} data-fallback={fallbackFor(n)} onerror={ONERROR} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>
                <div>
                  <span class={`cat ${catOf(n).cls}`}>{catOf(n).label}</span>
                  <a href={url(`/news/#${n.id}`)} tabindex={i >= updates.length ? -1 : undefined} lang={isHindi(n.title) ? 'hi' : undefined}>{cleanTitle(n.title)}</a>
                  <small>{n.outlets.length > 1 ? `${n.outlets.length} outlets reporting` : n.outlets[0]}</small>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="ticker-foot"><span>Hover to browse</span><a href={url('/news/')}>All news →</a></div>
      </aside>
    )}
    {heroImg && <p class="credit">{heroImg.caption} {credit(heroImg)} · <a href={heroImg.sourceUrl} target="_blank" rel="noopener noreferrer">{heroImg.sourceName}</a></p>}
  </section>

  <!-- 2. LIFE STORY: full-screen chapter slides; arrows bottom-right, or simply scroll on -->
  <section class="ls" id="life-story" aria-roledescription="carousel" aria-label="His life in chapters">
    <div class="ls-head">
      <span class="eyebrow">The life story</span>
      <h2>His life, in {life.length} chapters</h2>
    </div>
    <div class="ls-track" id="ls-track" tabindex="0" aria-label="Chapters — use the arrow keys to move between them">
      {life.map((c, i) => {
        const img = originalFor(c.id);
        const cover = img && (img.width || 0) >= 1100 && (img.width || 0) >= (img.height || 0);
        return (
          <article class={`ls-slide ${cover ? 'cover' : ''}`} aria-roledescription="slide" aria-label={`${i + 1} of ${life.length}: ${c.data.title}`} style={img ? `--img-h:${img.height}px` : undefined}>
            <span class="ls-media" aria-hidden="true">
              {img && <span class="blur"><Picture img={img} sizes="40vw" alt="" /></span>}
              {img && <span class="fg"><Picture img={img} sizes="(min-width: 900px) 60vw, 100vw" alt="" /></span>}
            </span>
            <div class="ls-cap">
              <span class="ls-k">{String(i + 1).padStart(2, '0')} · {c.data.period}</span>
              <h3><a href={url(`/life/${c.id}/`)}>{c.data.title}</a></h3>
              {c.data.summary && <p>{c.data.summary}</p>}
              <a class="ls-more" href={url(`/life/${c.id}/`)} tabindex="-1">Read chapter →</a>
              {img && <p class="ls-credit">{img.caption?.split('. ')[0].replace(/\.$/, '')}. {credit(img)}</p>}
            </div>
          </article>
        );
      })}
      <article class="ls-slide ls-end" aria-roledescription="slide" aria-label="Explore more">
        <div class="ls-cap">
          <span class="ls-k">Keep going</span>
          <h3>Explore more of his life</h3>
          <p>Every date, every degree, every photograph — with sources.</p>
          <span class="ls-links">
            <a class="btn btn-primary" href={url('/timeline/')}>Timeline</a>
            <a class="btn btn-ghost" href={url('/education/')}>Educational journey</a>
            <a class="btn btn-ghost" href={url('/gallery/')}>Gallery</a>
          </span>
        </div>
      </article>
    </div>
    <div class="ls-ctrl">
      <span class="ls-count" aria-live="polite"><b id="ls-n">01</b> / {String(life.length).padStart(2, '0')}</span>
      <span class="ls-bar" aria-hidden="true"><i id="ls-bar"></i></span>
      <button class="ls-btn" type="button" data-ls="-1" aria-label="Previous chapter" disabled>←</button>
      <button class="ls-btn" type="button" data-ls="1" aria-label="Next chapter">→</button>
    </div>
  </section>

  <!-- 3. CONSTITUTION -->
  <section class="band">
    {bandConst && <div class="bg"><Picture img={bandConst} sizes="100vw" alt="" /></div>}
    <div class="wrap band-inner">
      <span class="eyebrow">The flagship · 1946–1950</span>
      <h2 style="max-width:14ch">The Constitution of India</h2>
      <p class="lede" style="max-width:52ch">As chairman of the Drafting Committee, he guided India's Constitution through the Constituent Assembly. Read what it promises in plain words, the articles he fought for, his speeches — and download the official text.</p>
      <div class="stats" style="margin:32px 0">
        <div class="stat"><strong>26 Nov 1949</strong><span>Adopted by the Constituent Assembly</span></div>
        <div class="stat"><strong>26 Jan 1950</strong><span>Came into force — Republic Day</span></div>
        <div class="stat"><strong>Article 17</strong><span>Abolished untouchability</span></div>
        <div class="stat"><strong>Article 32</strong><span>"The very soul of the Constitution"</span></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/constitution/')}>Explore the Constitution →</a>
        <a class="btn btn-ghost" href={url('/constitution/#documents')}>Download the official text</a>
      </div>
    </div>
    {bandConst && <p class="credit">{bandConst.caption?.slice(0, 80)}… · {bandConst.license}</p>}
  </section>

  <script is:inline>
    (function () {
      /* ---------- Live updates: auto-scroll, hover to browse, filter by tag ---------- */
      var ticker = document.querySelector('.ticker');
      if (ticker) {
        var view = ticker.querySelector('.ticker-view');
        var list = ticker.querySelector('.ticker-list');
        var manual = false;
        var offsetNow = function () {
          var t = getComputedStyle(list).transform;
          return t && t !== 'none' ? -new DOMMatrixReadOnly(t).m42 : 0;
        };
        var toManual = function () {
          if (manual) return;
          var off = offsetNow();
          manual = true;
          list.style.animation = 'none';
          view.classList.add('manual');
          view.scrollTop = off;
        };
        var toAuto = function () {
          if (!manual) return;
          var half = list.scrollHeight / 2;
          var dur = parseFloat(list.style.getPropertyValue('--dur')) || 120;
          var off = half ? view.scrollTop % half : 0;
          manual = false;
          view.classList.remove('manual');
          view.scrollTop = 0;
          list.style.animation = '';
          list.style.animationDelay = (half ? -(off / half) * dur : 0) + 's';
        };
        ticker.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') toManual(); });
        ticker.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') toAuto(); });
        view.addEventListener('touchstart', toManual, { passive: true });
        view.addEventListener('focusin', toManual);
        var tags = ticker.querySelectorAll('[data-tcat]');
        tags.forEach(function (b) {
          b.addEventListener('click', function () {
            var c = b.dataset.tcat, shown = 0;
            tags.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
            list.querySelectorAll('li').forEach(function (li) {
              var ok = c === 'all' || li.dataset.cat === c;
              li.hidden = !ok;
              if (ok) shown++;
            });
            list.style.setProperty('--dur', Math.max(20, (shown / 2) * 6) + 's');
            list.style.animationDelay = '0s';
            view.scrollTop = 0;
          });
        });
      }

      /* ---------- Life story: arrow buttons, keys and swipe move between slides ---------- */
      var ls = document.querySelector('.ls');
      if (!ls) return;
      var track = ls.querySelector('.ls-track');
      var slides = track.querySelectorAll('.ls-slide');
      var count = slides.length - 1; // the last slide is "explore more"
      var nEl = document.getElementById('ls-n'), bar = document.getElementById('ls-bar');
      var prev = ls.querySelector('[data-ls="-1"]'), next = ls.querySelector('[data-ls="1"]');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var cur = 0;
      var index = function () { return Math.round(track.scrollLeft / Math.max(1, track.clientWidth)); };
      var show = function (i) {
        nEl.textContent = String(Math.min(i + 1, count)).padStart(2, '0');
        bar.style.transform = 'scaleX(' + (slides.length > 1 ? i / (slides.length - 1) : 1) + ')';
        prev.disabled = i <= 0;
        next.disabled = i >= slides.length - 1;
        slides.forEach(function (s, k) { s.toggleAttribute('inert', k !== i); });
      };
      var go = function (i) {
        cur = Math.max(0, Math.min(slides.length - 1, i));
        track.scrollTo({ left: cur * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
        show(cur);
      };
      prev.addEventListener('click', function () { go(cur - 1); });
      next.addEventListener('click', function () { go(cur + 1); });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
      });
      // Swipes and trackpad gestures: settle on whichever slide is showing
      var t = 0;
      track.addEventListener('scroll', function () {
        clearTimeout(t);
        t = setTimeout(function () { cur = index(); show(cur); }, 120);
      }, { passive: true });
      window.addEventListener('resize', function () { track.scrollLeft = cur * track.clientWidth; });
      show(0);
    })();
  </script>
</Base>
