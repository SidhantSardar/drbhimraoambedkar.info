  <FilmGrain />
  <script is:inline>
    (function () {
      /* ---------- Inside the volumes: Books / Speeches / Newspapers tabs ---------- */
      var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-shelf-tab]'));
      var pick = function (b, focus) {
        tabs.forEach(function (x) {
          var on = x === b;
          x.setAttribute('aria-selected', on ? 'true' : 'false'); x.tabIndex = on ? 0 : -1;
          document.getElementById(x.getAttribute('aria-controls')).hidden = !on;
        });
        if (focus) b.focus();
        arrows();
      };
      // One row of cards; the arrows move it by a screenful and switch off at either end.
      var arrows = function () {
        document.querySelectorAll('.shelf-row').forEach(function (row) {
          var ul = row.querySelector('.shelf-grid'), max = ul.scrollWidth - ul.clientWidth - 2;
          row.querySelector('.prev').disabled = ul.scrollLeft <= 2;
          row.querySelector('.next').disabled = ul.scrollLeft >= max;
          row.classList.toggle('fits', max <= 0);
        });
      };
      document.querySelectorAll('.shelf-row').forEach(function (row) {
        var ul = row.querySelector('.shelf-grid');
        row.querySelectorAll('[data-shelf-go]').forEach(function (b) {
          b.addEventListener('click', function () { ul.scrollBy({ left: Number(b.dataset.shelfGo) * ul.clientWidth * 0.85, behavior: 'smooth' }); });
        });
        ul.addEventListener('scroll', function () { arrows(); }, { passive: true });
      });
      window.addEventListener('resize', arrows);
      arrows();
      tabs.forEach(function (b, i) {
        b.addEventListener('click', function () { pick(b); });
        b.addEventListener('keydown', function (e) {
          var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (d) { e.preventDefault(); pick(tabs[(i + d + tabs.length) % tabs.length], true); }
        });
      });
    })();
    (function () {
      /* ---------- Hero: numbers count up ---------- */
      /* ---------- Scroll reveal: blocks marked data-reveal fade and rise in once, when they enter the viewport ---------- */
      var rev = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
        rev.forEach(function (el) { io.observe(el); });
      } else { rev.forEach(function (el) { el.classList.add('is-in'); }); }
      /* safety net: whatever happens, nothing stays hidden for long */
      setTimeout(function () { rev.forEach(function (el) { el.classList.add('is-in'); }); }, 3000);
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-count]').forEach(function (dd) {
        var end = Number(dd.dataset.count);
        if (still || !end) return;
        var t0 = performance.now(), dur = 1600;
        var step = function (now) {
          var p = Math.min(1, (now - t0) / dur), v = Math.round(end * (1 - Math.pow(1 - p, 3)));
          dd.textContent = v.toLocaleString('en-IN');
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });

      /* ---------- Live updates: auto-scroll, hover to browse, filter by tag ---------- */
      var ticker = document.querySelector('.ticker');
      // Light design: the column is a drawer that slides in from the right.
      var openBtn = document.querySelector('[data-ticker-open]');
      var closeBtn = document.querySelector('[data-ticker-close]');
      /* light design: the drawer is fixed to the screen, so lift it (and its tab) out of the hero's stacking layer to sit above every section */
      if (document.documentElement.dataset.skin === 'light') {
        if (ticker) document.body.appendChild(ticker);
        if (openBtn) document.body.appendChild(openBtn);
      }
      var setDrawer = function (open) {
        ticker.classList.toggle('open', open);
        if (openBtn) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      if (ticker && openBtn) openBtn.addEventListener('click', function () { setDrawer(true); });
      if (ticker && closeBtn) closeBtn.addEventListener('click', function () { setDrawer(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && ticker) setDrawer(false); });
      document.addEventListener('click', function (e) { if (ticker && ticker.classList.contains('open') && !ticker.contains(e.target) && !(openBtn && openBtn.contains(e.target))) setDrawer(false); });
      if (ticker) {
        var view = ticker.querySelector('.ticker-view');
        var list = ticker.querySelector('.ticker-list');
        var manual = false;
        var offsetNow = function () {
          var t = getComputedStyle(list).transform;
          return t && t !== 'none' ? -new DOMMatrixReadOnly(t).m42 : 0;
        };
        var toManual = function () {
          if (manual) return;
          var off = offsetNow();
          manual = true;
          list.style.animation = 'none';
          view.classList.add('manual');
          view.scrollTop = off;
        };
        var toAuto = function () {
          if (!manual) return;
          var half = list.scrollHeight / 2;
          var dur = parseFloat(list.style.getPropertyValue('--dur')) || 120;
          var off = half ? view.scrollTop % half : 0;
          manual = false;
          view.classList.remove('manual');
          view.scrollTop = 0;
          list.style.animation = '';
          list.style.animationDelay = (half ? -(off / half) * dur : 0) + 's';
        };
        ticker.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') toManual(); });
        ticker.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') toAuto(); });
        view.addEventListener('touchstart', toManual, { passive: true });
        view.addEventListener('focusin', toManual);
        var tags = ticker.querySelectorAll('[data-tcat]');
        tags.forEach(function (b) {
          b.addEventListener('click', function () {
            var c = b.dataset.tcat, shown = 0;
            tags.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
            list.querySelectorAll('li').forEach(function (li) {
              var ok = c === 'all' || li.dataset.cat === c;
              li.hidden = !ok;
              if (ok) shown++;
            });
            list.style.setProperty('--dur', Math.max(20, (shown / 2) * 6) + 's');
            list.style.animationDelay = '0s';
            view.scrollTop = 0;
          });
        });
      }

      /* ---------- Life story: arrow buttons, keys and swipe move between slides ---------- */
      var ls = document.querySelector('.ls');
      if (!ls) return;
      var track = ls.querySelector('.ls-track');
      var slides = track.querySelectorAll('.ls-slide');
      var count = slides.length - 1; // the last slide is "explore more"
      var nEl = document.getElementById('ls-n'), bar = document.getElementById('ls-bar');
      var prev = ls.querySelector('[data-ls="-1"]'), next = ls.querySelector('[data-ls="1"]');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var cur = 0;
      var index = function () { return Math.round(track.scrollLeft / Math.max(1, track.clientWidth)); };
      var show = function (i) {
        nEl.textContent = String(Math.min(i + 1, count)).padStart(2, '0');
        bar.style.transform = 'scaleX(' + (slides.length > 1 ? i / (slides.length - 1) : 1) + ')';
        prev.disabled = i <= 0;
        next.disabled = i >= slides.length - 1;
        slides.forEach(function (s, k) { s.toggleAttribute('inert', k !== i); });
      };
      var go = function (i) {
        cur = Math.max(0, Math.min(slides.length - 1, i));
        track.scrollTo({ left: cur * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
        show(cur);
      };
      prev.addEventListener('click', function () { go(cur - 1); });
      next.addEventListener('click', function () { go(cur + 1); });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
      });
      // Swipes and trackpad gestures: settle on whichever slide is showing
      var t = 0;
      track.addEventListener('scroll', function () {
        clearTimeout(t);
        t = setTimeout(function () { cur = index(); show(cur); }, 120);
      }, { passive: true });
      window.addEventListener('resize', function () { track.scrollLeft = cur * track.clientWidth; });
      show(0);
    })();
  </script>
</Base>
