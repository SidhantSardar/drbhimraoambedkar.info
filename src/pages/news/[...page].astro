---
import Base from '../../layouts/Base.astro';
import { loadNews, catOf, thumbFor, fallbackFor, ONERROR, mixed, isHindi, cleanTitle } from '../../lib/news';
import { url, SHOW_NEWS } from '../../lib/site';
import { getLang, translator } from '../../i18n';

// Builds /news/ only while SHOW_NEWS is on; otherwise the page does not exist at all (and is left out of the sitemap).
export function getStaticPaths() {
  return SHOW_NEWS ? [{ params: { page: undefined } }] : [];
}
const lang = getLang(Astro);
const t = translator(lang);
const mr = lang === 'mr';
const cat = (s: { category: string }) => catOf(s, lang);
const outlets = (n: number) => t(`${n} ${n === 1 ? 'outlet' : 'outlets'}`, `${n} माध्यमे`);

const news = loadNews();
const stories = mixed(news.stories, news.stories.length);
const categories = [...new Set(stories.map((s) => s.category))];
const day = (d: string | null) => (d ? new Date(d).toLocaleDateString(mr ? 'mr-IN' : 'en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }) : '');
---
<Base title={t('News', 'बातम्या')} description={t('Daily news on caste, justice, the Constitution and the Ambedkarite movement — each story explained, with every source listed.', 'जात, न्याय, संविधान आणि आंबेडकरी चळवळीविषयी दररोजच्या बातम्या — प्रत्येक बातमी स्पष्ट करून, सर्व स्रोतांसह.')}>
  <section class="news-app">
    <aside class="news-list" aria-label={t('Stories', 'बातम्या')}>
      <div class="news-list-head">
        <h1>{t('News', 'बातम्या')}</h1>
        <p class="muted">{t('Updated every six hours. Select a story to read what happened and who reported it.', 'दर सहा तासांनी अद्ययावत. काय घडले आणि ते कोणी नोंदवले हे वाचण्यासाठी बातमी निवडा.')}</p>
        {mr && <p class="muted" style="font-size:0.85rem">बातम्यांचे मथळे आणि सारांश मूळ भाषेत (इंग्रजी/हिंदी) दिले आहेत.</p>}
        <div class="filter-row" role="group" aria-label={t('Topics', 'विषय')}>
          <button class="chip" type="button" data-cat="all" aria-pressed="true">{t('All', 'सर्व')}</button>
          {categories.map((c) => <button class="chip" type="button" data-cat={c} aria-pressed="false">{cat({ category: c }).label}</button>)}
        </div>
      </div>
      <ol>
        {stories.map((s, i) => (
          <li data-cat={s.category}>
            <a href={`#${s.id}`} data-story={s.id} aria-current={i === 0 ? 'true' : undefined}>
              <img src={thumbFor(s)} data-fallback={fallbackFor(s)} onerror={ONERROR} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              <span>
                <span class={`cat ${cat(s).cls}`}>{cat(s).label}</span>
                <strong lang={isHindi(s.title) ? 'hi' : 'en'}>{cleanTitle(s.title)}</strong>
                <small>{s.outlets.length > 1 ? outlets(s.outlets.length) : s.outlets[0]}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </aside>

    <div class="news-detail">
      {stories.map((s, i) => (
        <article id={s.id} class="story" hidden={i !== 0} data-pagefind-ignore>
          <figure class="story-img"><img src={thumbFor(s, 960)} data-fallback={fallbackFor(s, 960)} onerror={ONERROR} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" /></figure>
          <div class="story-body">
            <span class={`cat ${cat(s).cls}`}>{cat(s).label}</span>
            <h2 lang={isHindi(s.title) ? 'hi' : 'en'}>{cleanTitle(s.title)}</h2>
            <p class="muted story-meta">{day(s.date)} · {t(`Reported by ${outlets(s.outlets.length)}`, s.outlets.length === 1 ? '1 माध्यमाने दिलेली बातमी' : `${s.outlets.length} माध्यमांनी दिलेली बातमी`)}</p>

            {s.summary ? (
              <div class="story-summary" lang="en">
                <h3 lang={lang}>{t('What happened', 'काय घडले')}</h3>
                {s.summary.split(/\n\n+/).map((p) => <p>{p}</p>)}
                <p class="note" lang={lang}>{t('Summary written by AI from the reports listed below. Read the original reports before quoting.', 'हा सारांश खालील बातम्यांच्या आधारे AI ने लिहिला आहे. उद्धृत करण्यापूर्वी मूळ बातम्या वाचा.')}</p>
              </div>
            ) : (
              <div class="story-summary">
                <h3>{t('What the reports say', 'बातम्यांमध्ये काय म्हटले आहे')}</h3>
                {s.reports.find((r) => r.snippet) ? <p lang="en">{s.reports.find((r) => r.snippet)!.snippet}</p> : <p lang="en">{s.title}.</p>}
                {s.reports.length > 1 && <p>{t('This story was reported by', 'ही बातमी यांनी दिली:')} {s.outlets.slice(0, -1).join(', ')}{s.outlets.length > 1 ? ` ${t('and', 'आणि')} ${s.outlets[s.outlets.length - 1]}` : ''}.</p>}
              </div>
            )}

            {s.reports.length > 1 && (
              <div class="story-coverage">
                <h3>{t('How it was covered', 'कोणी कसे मांडले')}</h3>
                <ul>
                  {s.reports.map((r) => <li><strong>{r.outlet}</strong><span lang={isHindi(r.title) ? 'hi' : undefined}>{r.title}</span></li>)}
                </ul>
              </div>
            )}

            <div class="story-sources">
              <h3>{t('Sources', 'स्रोत')}</h3>
              <ol>
                {s.reports.map((r) => (
                  <li><a href={r.link} target="_blank" rel="noopener noreferrer nofollow">{r.title}</a> <span class="muted">— {r.outlet}{r.date ? `, ${day(r.date)}` : ''}</span></li>
                ))}
              </ol>
            </div>
          </div>
        </article>
      ))}
      {stories.length === 0 && <p class="notice" style="margin:40px">{t('News will appear here after the next automatic update.', 'पुढील स्वयंचलित अद्ययावतानंतर बातम्या येथे दिसतील.')}</p>}
    </div>
  </section>
  <p class="wrap muted" style="font-size:0.85rem;padding-block:24px">{t('Headlines and pictures belong to their publishers; this page links to them and does not copy articles. Listing a report does not mean we endorse it.', 'मथळे आणि छायाचित्रे त्यांच्या प्रकाशकांची आहेत; हे पान त्यांचे दुवे देते, लेखांची नक्कल करत नाही. एखादी बातमी येथे दिल्याचा अर्थ आम्ही तिला दुजोरा देतो असा नाही.')} <a href={url('/contribute/')}>{t('Suggest a news source', 'बातम्यांचा स्रोत सुचवा')}</a>.</p>

  <script is:inline>
    (function () {
      var links = document.querySelectorAll('[data-story]');
      function show(id, scroll) {
        var target = document.getElementById(id);
        if (!target) return;
        document.querySelectorAll('.story').forEach(function (a) { a.hidden = a !== target; });
        links.forEach(function (l) { l.setAttribute('aria-current', l.dataset.story === id ? 'true' : 'false'); });
        var detail = document.querySelector('.news-detail');
        detail.scrollTop = 0;
        if (scroll && window.innerWidth < 1000) detail.scrollIntoView({ behavior: 'smooth' });
      }
      links.forEach(function (l) {
        l.addEventListener('click', function (e) { e.preventDefault(); history.replaceState(null, '', '#' + l.dataset.story); show(l.dataset.story, true); });
      });
      if (location.hash) show(location.hash.slice(1), false);
      var btns = document.querySelectorAll('button[data-cat]');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          var c = b.dataset.cat;
          btns.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
          document.querySelectorAll('.news-list li').forEach(function (li) { li.hidden = c !== 'all' && li.dataset.cat !== c; });
        });
      });
    })();
  </script>
</Base>
