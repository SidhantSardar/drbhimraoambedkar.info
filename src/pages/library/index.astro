---
import Base from '../../layouts/Base.astro';
import { volumes, tocOf, firstChapter, coverOf } from '../../lib/library';
import { url } from '../../lib/site';
const vols = volumes();
const totalPages = vols.reduce((s, v) => s + v.pages, 0);
---
<Base title="Library — Writings and Speeches" description="Read every volume of Dr. Babasaheb Ambedkar: Writings and Speeches online, chapter by chapter, word for word from the official Government of India edition.">
  <section class="hero">
    <div class="wrap section-tight">
      <span class="eyebrow">The library</span>
      <h1 style="font-size:var(--step-3)">Dr. Babasaheb Ambedkar: Writings and Speeches</h1>
      <p class="lede" style="max-width:64ch">The complete English edition — {vols.length} books, {totalPages.toLocaleString('en-IN')} pages — to read here, chapter by chapter. The text is taken word for word from the official volumes published by the Government of India, and every page links to the original.</p>
      <div class="btn-row" style="margin-top:20px"><a class="btn btn-ghost" href={url('/ask/')}>Search all volumes →</a></div>
    </div>
  </section>
  <div class="wrap section">
    <ul class="shelf">
      {vols.map((v) => {
        const start = firstChapter(v);
        const chapters = tocOf(v).filter((c) => c.title !== 'Front matter').length;
        const read = url(start ? `/library/${v.id}/${start.slug}/` : `/library/${v.id}/`);
        return (
          <li class="book">
            <a class="book-cover" href={read} aria-label={`Read ${v.label}: ${v.title}`}>
              <img src={url(coverOf(v))} alt="" width="360" height="540" loading="lazy" decoding="async" />
              <span class="book-spine" aria-hidden="true"></span>
            </a>
            <div class="book-body">
              <span class="book-vol">{v.label}</span>
              <h2 class="book-title"><a href={url(`/library/${v.id}/`)}>{v.title}</a></h2>
              <p class="book-meta">{chapters} chapters · {v.pages} pages</p>
              <div class="book-actions">
                <a class="read-now" href={read}>Read now →</a>
                <a class="pdf-link" href={v.officialUrl} target="_blank" rel="noopener noreferrer">Official PDF ↗</a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="callout" style="margin-top:40px">
      <h2 style="font-size:var(--step-1)">In Hindi — सम्पूर्ण वाङ्मय</h2>
      <p>The Government of India also publishes the collected works in Hindi, in 40 volumes. They are available as PDFs from the Ministry of External Affairs: <a href="https://www.mea.gov.in/books-writings-of-ambedkar" target="_blank" rel="noopener noreferrer">Books &amp; Writings of Ambedkar ↗</a>. A readable Hindi library is planned.</p>
    </div>
  </div>
</Base>
