---
// The original editions: one card per book, as on the home page, each opening its page-by-page scan on the
// Internet Archive. Every one of these books is reprinted in the volumes, so the page sends readers on to them.
import Base from '../../../layouts/Base.astro';
import Picture from '../../../components/Picture.astro';
import { FIRST_EDITIONS, firstEditionHref } from '../../../lib/first-editions';
import { volumes, coverOf } from '../../../lib/library';
import { images, type Img } from '../../../lib/data';
import { url } from '../../../lib/site';
import { getLang, translator } from '../../../i18n';
const lang = getLang(Astro);
const t = translator(lang);
const pictures = images(lang);
const books = FIRST_EDITIONS.map((fe) => ({ fe, img: pictures.find((p) => p.id === fe.cover) as Img | undefined, href: firstEditionHref(fe) }));
const first = FIRST_EDITIONS[0].year;
const last = FIRST_EDITIONS[FIRST_EDITIONS.length - 1].year;
const vol1 = volumes()[0];
---
<Base title={t('Original first editions — his books as first printed', 'मूळ पहिल्या आवृत्त्या — प्रथम छापले तसे त्यांचे ग्रंथ')} description={t(`${books.length} of Dr. B. R. Ambedkar's books as they were first printed, ${first} to ${last}, from Digital Library of India scans on the Internet Archive. Every one of them is reprinted in the volumes of Writings and Speeches.`, `डॉ. बाबासाहेब आंबेडकर यांचे ${books.length} ग्रंथ प्रथम छापले तसे, ${first} ते ${last}, इंटरनेट आर्काइव्हवरील डिजिटल लायब्ररी ऑफ इंडियाच्या स्कॅनमधून. हे सर्व ग्रंथ “लेखन आणि भाषणे” या खंडांत पुनर्मुद्रित आहेत.`)}>
  <section class="hero">
    <div class="wrap section-tight">
      <a class="eyebrow" href={url('/library/')} style="text-decoration:none">{t('← Library', '← ग्रंथालय')}</a>
      <h1 style="font-size:var(--step-3)">{t('Original first editions', 'मूळ पहिल्या आवृत्त्या')}</h1>
      <p class="lede" style="max-width:64ch">{t(`These are his books as they were first printed: ${books.length} original copies from ${first} to ${last}, scanned page by page from Indian libraries by the Digital Library of India and kept on the Internet Archive. Most are first editions; where none is online, the card says which printing it is.`, `हे त्यांचे ग्रंथ प्रथम छापले गेले तसे आहेत: ${first} ते ${last} या काळातील ${books.length} मूळ प्रती, डिजिटल लायब्ररी ऑफ इंडियाने भारतातील ग्रंथालयांतून पान न् पान स्कॅन केलेल्या आणि इंटरनेट आर्काइव्हवर जतन केलेल्या. यांपैकी बहुतेक पहिल्या आवृत्त्या आहेत; जिथे पहिली आवृत्ती ऑनलाइन नाही, तिथे ती कोणती छपाई आहे हे कार्डवर लिहिले आहे.`)}</p>
      <div class="fe-volumes">
        <img src={url(coverOf(vol1))} alt="" width="707" height="1100" loading="eager" decoding="async" />
        <div>
          <h2>{t('Read them in the volumes', 'हे ग्रंथ खंडांत वाचा')}</h2>
          <p>{t('Every book here is reprinted in Dr. Babasaheb Ambedkar: Writings and Speeches, the official volumes, together with his speeches, papers and unpublished writings. On this site the volumes are clear text you can read, search and listen to, chapter by chapter. To read his books, we recommend continuing with the volumes; the originals show how each book first looked.', 'येथील प्रत्येक ग्रंथ “डॉ. बाबासाहेब आंबेडकर: लेखन आणि भाषणे” या अधिकृत खंडांत पुनर्मुद्रित आहे, त्यांची भाषणे, लेख आणि अप्रकाशित लेखन यांसह. या संकेतस्थळावर हे खंड प्रकरणानुसार वाचता, शोधता आणि ऐकता येणाऱ्या स्पष्ट मजकुरात आहेत. त्यांचे ग्रंथ वाचण्यासाठी आम्ही खंडच सुचवतो; मूळ आवृत्त्या दाखवतात की प्रत्येक ग्रंथ प्रथम कसा दिसत होता.')}</p>
          <div class="btn-row"><a class="btn btn-primary" href={url('/library/')}>{t('Explore all 17 volumes →', 'सर्व 17 खंड पाहा →')}</a></div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap section-tight">
    <ul class="fe-grid">
      {books.map(({ fe, img, href }) => (
        <li>
          <a class="shelf-card" href={href}>
            <span class="shelf-cover">
              {img ? <Picture img={img} sizes="(max-width: 600px) 45vw, 240px" alt="" /> : (
                <span class="shelf-plain" aria-hidden="true"><b>{t(...fe.title)}</b><small>B. R. Ambedkar · {fe.year}</small></span>
              )}
            </span>
            <span class="shelf-body">
              <span class="shelf-year">{fe.year}</span>
              <strong>{t(...fe.title)}</strong>
              {fe.subtitle && <span class="fe-sub">{t(...fe.subtitle)}</span>}
              <span class="shelf-desc">{t(...fe.desc)}</span>
              <span class="shelf-ed">{t(...fe.edition)}</span>
              <span class="shelf-vol">{t('See the pages', 'पाने पाहा')} <i aria-hidden="true">→</i></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="source-link fe-credit">{t('Scans by the Digital Library of India from copies in Indian libraries, kept on the Internet Archive. His writings are in the public domain in India.', 'डिजिटल लायब्ररी ऑफ इंडियाने भारतातील ग्रंथालयांतील प्रतींवरून केलेले स्कॅन, इंटरनेट आर्काइव्हवर उपलब्ध. त्यांचे लेखन भारतात सार्वजनिक क्षेत्रात (public domain) आहे.')}</p>

    <div class="callout fe-continue">
      <h2>{t('Continue in the volumes', 'खंडांत वाचन सुरू ठेवा')}</h2>
      <p>{t('All of these books, with his speeches and papers, are in the 17 volumes of Writings and Speeches, ready to read on this site.', 'हे सर्व ग्रंथ, त्यांची भाषणे आणि लेख यांसह, “लेखन आणि भाषणे” च्या 17 खंडांत आहेत — या संकेतस्थळावर वाचण्यासाठी तयार.')}</p>
      <div class="btn-row"><a class="btn btn-primary" href={url('/library/')}>{t('Explore all 17 volumes →', 'सर्व 17 खंड पाहा →')}</a></div>
    </div>
  </div>
</Base>

<style>
  .fe-volumes {
    display: grid; grid-template-columns: 92px 1fr; gap: 22px; align-items: start; max-width: 820px; margin-top: 28px;
    padding: 20px 22px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface-2);
  }
  .fe-volumes img { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: 0 10px 24px -12px rgb(0 0 0 / 70%); }
  .fe-volumes h2 { font-size: var(--step-1); margin: 0 0 8px; }
  .fe-volumes p { margin: 0 0 16px; font-size: 1rem; color: var(--ink-2); line-height: 1.65; }
  @media (max-width: 560px) { .fe-volumes { grid-template-columns: 1fr; } .fe-volumes img { width: 84px; } }

  /* the home page's book cards, in a grid that wraps */
  .fe-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 176px), 1fr)); gap: 26px 20px; }
  .fe-grid > li { display: flex; }
  .fe-sub { font-size: 0.8rem; font-style: italic; line-height: 1.35; color: var(--ink-2); }
  @media (max-width: 560px) { .fe-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; } }

  .fe-credit { margin-top: 18px; text-align: center; }
  .fe-continue { margin-top: 48px; text-align: center; }
  .fe-continue h2 { font-size: var(--step-1); margin: 0 0 8px; }
  .fe-continue .btn-row { justify-content: center; margin-top: 16px; }
</style>
