---
import DocsShell from '../../../components/DocsShell.astro';
import { volumes, leavesOf, pagesOf, formatPage, chapterBlocks, marathiOf, titleIn, volLabelIn, type Volume, type Leaf } from '../../../lib/library';
import { url } from '../../../lib/site';
import { getLang, translator } from '../../../i18n';

export function getStaticPaths() {
  return volumes().flatMap((vol) => {
    const leaves = leavesOf(vol);
    return leaves.map((leaf, i) => ({
      params: { volume: vol.id, section: leaf.slug },
      props: { vol, leaf, prev: leaves[i - 1], next: leaves[i + 1] },
    }));
  });
}

interface Props { vol: Volume; leaf: Leaf; prev?: Leaf; next?: Leaf }
const { vol, leaf, prev, next } = Astro.props;
const lang = getLang(Astro);
const t = translator(lang);
const mr = lang === 'mr';
const rows = pagesOf(vol).filter((r) => r.p >= leaf.start && r.p <= leaf.end);
const hasText = rows.some((r) => r.t.length > 40);

// Marathi: the translation is stored as aligned paragraphs (chapterBlocks), so the English shown beside it uses the same paragraphs.
const marathi = marathiOf(vol);
const translated = mr && rows.length > 0 && rows.every((r) => marathi.pages.has(r.p));
const aligned = translated ? chapterBlocks(rows) : [];
const reviewed = translated && rows.every((r) => /reviewed: yes/.test(marathi.pages.get(r.p)?.by || ''));
const summary = translated ? marathi.summaries[leaf.slug] : undefined;
const pagesShown = rows.map((r, i) => ({
  ...r,
  blocks: translated ? marathi.pages.get(r.p)!.b : formatPage(r.t),
  english: translated ? aligned[i].blocks : [],
}));

const name = (s: string) => titleIn(vol, s, lang);
const chapterTitle = name(leaf.chapter.title);
const partLabel = leaf.chapter.parts.length > 1 ? name(leaf.title) : '';
const labelOf = (l: Leaf) => (l.chapter.parts.length > 1 ? `${name(l.chapter.title)} — ${name(l.title)}` : name(l.chapter.title));
const volLabel = volLabelIn(vol, lang);
---
<DocsShell vol={vol} current={leaf.slug} title={`${chapterTitle}${partLabel ? ` (${partLabel})` : ''} — ${volLabel}`} description={t(`${leaf.chapter.title}, from ${vol.label} of Dr. Babasaheb Ambedkar: Writings and Speeches — the full text, page by page.`, translated ? `${chapterTitle} — डॉ. बाबासाहेब आंबेडकर: लेखन आणि भाषणे, ${volLabel}. पान न् पान मराठी अनुवाद, मूळ इंग्रजीसह.` : `${chapterTitle} — डॉ. बाबासाहेब आंबेडकर: लेखन आणि भाषणे, ${volLabel}. पान न् पान संपूर्ण मजकूर.`)}>
  <article
    class="docs-article"
    data-pagefind-body={hasText ? '' : undefined}
    data-pagefind-filter="collection:Writings and Speeches"
    data-pagefind-meta={`title:${chapterTitle}${partLabel ? ` · ${partLabel}` : ''} — ${volLabel}`}
  >
    <span hidden data-pagefind-filter="volume">{vol.label}</span>
    <span hidden data-pagefind-meta="pdf">{vol.sourceUrl}</span>
    <span hidden data-pagefind-meta="volumeTitle">{vol.title}</span>

    <nav class="docs-crumbs" aria-label={t('Breadcrumb', 'मार्ग')} data-pagefind-ignore>
      <a href={url('/library/')}>{t('Library', 'ग्रंथालय')}</a> <span>/</span>
      <a href={url(`/library/${vol.id}/`)}>{volLabel}</a>
      {leaf.chapter.group && <><span>/</span> <span>{name(leaf.chapter.group)}</span></>}
    </nav>
    <header class="docs-head" data-pagefind-ignore>
      <h1>{chapterTitle}</h1>
      {mr && chapterTitle !== leaf.chapter.title && <p class="docs-orig-title"><span>मूळ इंग्रजी शीर्षक:</span> <span lang="en">{leaf.chapter.title}</span></p>}
      <p class="docs-meta">
        {partLabel && <span>{partLabel} · </span>}
        <span>{t(`PDF pages ${leaf.start}–${leaf.end}`, `PDF पृष्ठे ${leaf.start}–${leaf.end}`)}</span>
        <span> · {t(`Dr. Babasaheb Ambedkar: Writings and Speeches, ${vol.label}`, `डॉ. बाबासाहेब आंबेडकर: लेखन आणि भाषणे, ${volLabel}`)}</span>
      </p>
    </header>

    {hasText && (
      <div class="ra-anchor" data-ra-anchor data-pagefind-ignore>
      <div class="read-aloud" data-read-aloud hidden
        data-l-play={t('Listen', 'ऐका')} data-l-resume={t('Resume', 'पुढे ऐका')} data-l-pause={t('Pause', 'थांबवा')}
        data-l-novoice={t('No Marathi voice on this device, so a Hindi voice is reading. For a better Marathi voice, use Microsoft Edge or Chrome on Android, or add a Marathi voice in your device settings.', 'या उपकरणावर मराठी आवाज नाही, म्हणून हिंदी आवाज वाचत आहे. चांगल्या मराठी आवाजासाठी Microsoft Edge किंवा Android वरील Chrome वापरा, किंवा उपकरणाच्या सेटिंग्जमध्ये मराठी आवाज जोडा.')}
        data-l-none={t('This device has no voice for this language. You can add one in your device settings.', 'या उपकरणावर या भाषेसाठी आवाज नाही. उपकरणाच्या सेटिंग्जमध्ये तो जोडता येईल.')}>
        <button type="button" class="ra-play" data-ra-play aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="ra-i-listen" d="M4 14v-2a8 8 0 0 1 16 0v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <rect class="ra-i-listen" x="3" y="13" width="5" height="7" rx="1.5" />
            <rect class="ra-i-listen" x="16" y="13" width="5" height="7" rx="1.5" />
            <path class="ra-i-pause" d="M7 5h4v14H7zM13 5h4v14h-4z" />
          </svg>
          <span class="ra-label">{t('Listen', 'ऐका')}</span>
        </button>
        <button type="button" class="ra-stop" data-ra-stop hidden aria-label={t('Stop', 'थांबवा')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6z" /></svg></button>
        <label class="ra-rate"><span class="visually-hidden">{t('Listening speed', 'ऐकण्याचा वेग')}</span>
          <select data-ra-rate>
            <option value="0.8">0.8×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option>
          </select>
        </label>
        <label class="ra-voice"><span class="visually-hidden">{t('Voice', 'आवाज')}</span>
          <select data-ra-voice></select>
        </label>
        <p class="ra-msg" data-ra-msg hidden></p>
      </div>
      </div>
    )}

    {mr && translated && (
      <div class="mr-translation-note" data-pagefind-ignore>
        <p><strong>मराठी अनुवाद.</strong> {reviewed
          ? 'हा अनुवाद मराठी अभ्यासकांनी मूळ इंग्रजीशी तपासला आहे.'
          : 'हा अनुवाद AI (Claude) च्या मदतीने, आमच्या सार्वजनिक अनुवाद-मार्गदर्शिकेनुसार केलेला मसुदा आहे; अजून अभ्यासकांनी तपासलेला नाही.'} प्रत्येक परिच्छेदाचा मूळ इंग्रजी मजकूर पानाखालील “मूळ इंग्रजी” मध्ये आणि मूळ PDF चे पान उजवीकडील दुव्यावर पाहा. <a href={url('/contribute/#translation')}>अनुवादात चूक कळवा</a>.</p>
      </div>
    )}
    {mr && !translated && (
      <p class="mr-note" data-pagefind-ignore>या प्रकरणाचा मराठी अनुवाद अजून झालेला नाही. खाली मूळ इंग्रजी मजकूर (अधिकृत PDF मधून जसाच्या तसा) दिला आहे.</p>
    )}
    {summary && (
      <aside class="in-simple" data-pagefind-ignore>
        <h2>सोप्या शब्दांत</h2>
        <p>{summary}</p>
        <p class="muted">हा सारांश समजण्यासाठी आहे; हा बाबासाहेबांचा मूळ मजकूर नाही.</p>
      </aside>
    )}

    {pagesShown.map((r) => (
      <section class="docs-page">
        <div class="page-mark">
          <h2 id={`p${r.p}`}>{r.n ? t(`Page ${r.n}`, `पृष्ठ ${r.n}`) : t(`PDF page ${r.p}`, `PDF पृष्ठ ${r.p}`)}</h2>
          <a href={`${vol.sourceUrl}#page=${r.p}`} target="_blank" rel="noopener noreferrer" data-pagefind-ignore title={t('Compare with the original PDF page', 'मूळ PDF पानाशी तुलना करा')}>{t(`PDF p. ${r.p} ↗`, `PDF पृ. ${r.p} ↗`)}</a>
        </div>
        <div class="reader" lang={translated ? 'mr' : 'en'}>
          {r.blocks.length ? r.blocks.map((b) => (b.type === 'h' ? <h3>{b.text}</h3> : b.type === 'fn' ? <p class="fn">{b.text}</p> : <p>{b.text}</p>)) : <p class="muted">{t('(This page has no text — it may be blank or an image.)', '(या पानावर मजकूर नाही — ते कोरे किंवा चित्राचे पान असू शकते.)')}</p>}
        </div>
        {translated && r.english.length > 0 && (
          <details class="orig" data-pagefind-ignore>
            <summary>मूळ इंग्रजी</summary>
            <div class="reader reader-en" lang="en">{r.english.map((b) => (b.type === 'h' ? <h3>{b.text}</h3> : b.type === 'fn' ? <p class="fn">{b.text}</p> : <p>{b.text}</p>))}</div>
          </details>
        )}
      </section>
    ))}

    <p class="docs-note" data-pagefind-ignore>{translated
      ? 'मूळ इंग्रजी मजकूर भारत सरकारने प्रकाशित केलेल्या अधिकृत PDF मधून शब्दशः घेतला आहे. पानांच्या सीमेवर तुटलेला परिच्छेद अनुवादात तो सुरू होणाऱ्या पानावर पूर्ण दिला आहे. उद्धृत करण्यापूर्वी मूळ पान तपासा.'
      : t('Text taken word for word from the official PDF published by the Government of India. Line breaks have been joined into paragraphs; automatic extraction can still leave small errors, so check the original page before quoting.', 'मजकूर भारत सरकारने प्रकाशित केलेल्या अधिकृत PDF मधून शब्दशः घेतला आहे. ओळी जोडून परिच्छेद केले आहेत; स्वयंचलित प्रक्रियेत लहान चुका राहू शकतात, म्हणून उद्धृत करण्यापूर्वी मूळ पान तपासा.')}</p>

    <nav class="docs-pager" aria-label={t('Chapters', 'प्रकरणे')} data-pagefind-ignore>
      {prev ? <a href={url(`/library/${vol.id}/${prev.slug}/`)}><small>{t('← Previous', '← मागील')}</small><strong>{labelOf(prev)}</strong></a> : <span></span>}
      {next && <a class="next" href={url(`/library/${vol.id}/${next.slug}/`)}><small>{t('Next →', 'पुढील →')}</small><strong>{labelOf(next)}</strong></a>}
    </nav>
  </article>
  <script is:inline>
    (function () {
      /* Listen: text to speech with the voices on the reader's own device (Web Speech API). Nothing is sent anywhere. */
      var bar = document.querySelector('[data-read-aloud]'), anchor = document.querySelector('[data-ra-anchor]');
      if (!bar || !('speechSynthesis' in window) || !window.SpeechSynthesisUtterance) return;
      var synth = window.speechSynthesis;
      var playBtn = bar.querySelector('[data-ra-play]'), stopBtn = bar.querySelector('[data-ra-stop]');
      var rateSel = bar.querySelector('[data-ra-rate]'), voiceSel = bar.querySelector('[data-ra-voice]'), msg = bar.querySelector('[data-ra-msg]');
      var label = bar.querySelector('.ra-label');
      bar.hidden = false;

      var blocks = Array.prototype.slice.call(document.querySelectorAll('.docs-article .reader:not(.reader-en) > p:not(.fn):not(.muted), .docs-article .reader:not(.reader-en) > h3'));
      if (!blocks.length) { anchor.hidden = true; return; }
      var lang = (blocks[0].closest('.reader').getAttribute('lang') || 'en');
      var KEY = 'listen-voice-' + lang;

      // rank voices: natural / neural / online voices first, then Indian locales
      var score = function (v) {
        var n = (v.name || '') + ' ' + (v.voiceURI || ''), s = 0;
        if (/natural|neural|online|premium|enhanced|wavenet|studio/i.test(n)) s += 20;
        // a male voice first: Ambedkar's words in a man's voice (known male voices in Edge, macOS/iOS, Windows, Google)
        if (/\b(prabhat|manohar|madhur|rishi|ravi|hemant|aaron|daniel|arthur|male)\b/i.test(n)) s += 30;
        if (/\b(neerja|aarohi|swara|lekha|kalpana|heera|veena|female|samantha|karen|moira|tessa)\b/i.test(n)) s -= 15;
        if (/google/i.test(n)) s += 8;
        if (/-IN$/i.test(v.lang) || /_IN$/i.test(v.lang)) s += 5;
        if (v.localService === false) s += 2;
        return s;
      };
      var voices = [], voice = null, fallback = false;
      var load = function () {
        var all = synth.getVoices(); if (!all.length) return;
        var NOVELTY = /^(albert|bad news|bahh|bells|boing|bubbles|cellos|good news|jester|organ|superstar|trinoids|whisper|wobble|zarvox|junior|ralph|fred|kathy|grandma|grandpa|eddy|flo|reed|rocko|sandy|shelley)\b/i;
        var mine = all.filter(function (v) { return new RegExp('^' + lang, 'i').test(v.lang) && !NOVELTY.test(v.name); });
        fallback = false;
        if (!mine.length && lang === 'mr') { mine = all.filter(function (v) { return /^hi/i.test(v.lang); }); fallback = mine.length > 0; }
        voices = mine.sort(function (a, b) { return score(b) - score(a); });
        var saved = null; try { saved = localStorage.getItem(KEY); } catch (e) {}
        voice = voices.filter(function (v) { return v.voiceURI === saved; })[0] || voices[0] || null;
        voiceSel.innerHTML = '';
        voices.slice(0, 12).forEach(function (v) {
          var o = document.createElement('option'); o.value = v.voiceURI;
          o.textContent = v.name.replace(/^(Microsoft|Google)\s+/, '').replace(/\s*\(.*?\)\s*/g, ' ').replace(/\s+-\s+.*$/, '').trim() + (score(v) >= 20 ? ' ★' : '');
          if (voice && v.voiceURI === voice.voiceURI) o.selected = true;
          voiceSel.appendChild(o);
        });
        voiceSel.parentNode.hidden = voices.length < 2;
      };
      load();
      if (synth.onvoiceschanged !== undefined) synth.addEventListener('voiceschanged', load);
      voiceSel.addEventListener('change', function () {
        voice = voices.filter(function (v) { return v.voiceURI === voiceSel.value; })[0] || voice;
        try { localStorage.setItem(KEY, voiceSel.value); } catch (e) {}
        if (state === 'playing') { synth.cancel(); qi = Math.max(0, qi - 1); setTimeout(speakNext, 60); }
      });

      var chunks = function (text) {
        var parts = text.match(/[^.!?।॥]+[.!?।॥]*["”’)\]]*\s*/g) || [text], out = [], cur = '';
        parts.forEach(function (p) { if ((cur + p).length > 220 && cur) { out.push(cur); cur = p; } else cur += p; });
        if (cur.trim()) out.push(cur);
        return out;
      };
      var idx = 0, state = 'idle', queue = [], qi = 0;
      var mark = function (el) {
        blocks.forEach(function (b) { b.classList.remove('ra-now'); });
        if (!el) return;
        el.classList.add('ra-now');
        var r = el.getBoundingClientRect();
        if (r.top < 120 || r.bottom > innerHeight - 40) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };
      var setUI = function () {
        bar.classList.toggle('playing', state === 'playing');
        bar.classList.toggle('active', state !== 'idle');
        stopBtn.hidden = state === 'idle';
        var l = state === 'playing' ? bar.dataset.lPause : state === 'paused' ? bar.dataset.lResume : bar.dataset.lPlay;
        label.textContent = l; playBtn.setAttribute('aria-label', l);
        playBtn.setAttribute('aria-pressed', state === 'playing' ? 'true' : 'false');
      };
      var speakNext = function () {
        if (state !== 'playing') return;
        if (qi >= queue.length) {
          idx++; if (idx >= blocks.length) { stop(); return; }
          queue = chunks(blocks[idx].textContent); qi = 0; mark(blocks[idx]);
        }
        var u = new SpeechSynthesisUtterance(queue[qi++]);
        u.lang = voice ? voice.lang : (lang === 'mr' ? 'mr-IN' : 'en-IN');
        if (voice) u.voice = voice;
        u.rate = parseFloat(rateSel.value) || 1;
        u.onend = function () { speakNext(); };
        u.onerror = function (e) { if (e.error !== 'interrupted' && e.error !== 'canceled') speakNext(); };
        synth.speak(u);
      };
      var firstVisible = function () {
        for (var i = 0; i < blocks.length; i++) { var r = blocks[i].getBoundingClientRect(); if (r.bottom > 120) return i; }
        return 0;
      };
      var start = function () {
        load();
        msg.hidden = true;
        if (lang === 'mr' && fallback) { msg.textContent = bar.dataset.lNovoice; msg.hidden = false; }
        else if (!voice && synth.getVoices().length) { msg.textContent = bar.dataset.lNone; msg.hidden = false; }
        synth.cancel();
        idx = firstVisible(); queue = chunks(blocks[idx].textContent); qi = 0;
        state = 'playing'; setUI(); mark(blocks[idx]); speakNext();
      };
      var stop = function () { state = 'idle'; synth.cancel(); mark(null); setUI(); };
      playBtn.addEventListener('click', function () {
        if (state === 'idle') start();
        else if (state === 'playing') { synth.pause(); state = 'paused'; setUI(); }
        else { synth.resume(); state = 'playing'; setUI(); }
      });
      stopBtn.addEventListener('click', stop);
      rateSel.addEventListener('change', function () {
        if (state === 'playing') { synth.cancel(); qi = Math.max(0, qi - 1); setTimeout(speakNext, 60); }
      });
      blocks.forEach(function (b, i) {
        b.addEventListener('click', function () {
          if (state === 'idle' || window.getSelection().toString()) return;
          synth.cancel(); idx = i; queue = chunks(b.textContent); qi = 0; state = 'playing'; setUI(); mark(b); setTimeout(speakNext, 60);
        });
      });
      window.addEventListener('pagehide', function () { synth.cancel(); });

      // the floating island: once the bar scrolls out of view it docks in the top-right corner
      if ('IntersectionObserver' in window) {
        anchor.style.minHeight = bar.offsetHeight + 'px';
        new IntersectionObserver(function (es) {
          var gone = !es[0].isIntersecting && es[0].boundingClientRect.top < 0;
          bar.classList.toggle('docked', gone);
        }, { rootMargin: '-70px 0px 0px 0px' }).observe(anchor);
      }
      setUI();
    })();
  </script>
</DocsShell>
