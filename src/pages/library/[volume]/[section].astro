---
import DocsShell from '../../../components/DocsShell.astro';
import { volumes, leavesOf, pagesOf, formatPage, chapterBlocks, marathiOf, titleIn, volLabelIn, type Volume, type Leaf } from '../../../lib/library';
import { url } from '../../../lib/site';
import { getLang, translator } from '../../../i18n';

export function getStaticPaths() {
  return volumes().flatMap((vol) => {
    const leaves = leavesOf(vol);
    return leaves.map((leaf, i) => ({
      params: { volume: vol.id, section: leaf.slug },
      props: { vol, leaf, prev: leaves[i - 1], next: leaves[i + 1] },
    }));
  });
}

interface Props { vol: Volume; leaf: Leaf; prev?: Leaf; next?: Leaf }
const { vol, leaf, prev, next } = Astro.props;
const lang = getLang(Astro);
const t = translator(lang);
const mr = lang === 'mr';
const rows = pagesOf(vol).filter((r) => r.p >= leaf.start && r.p <= leaf.end);
const hasText = rows.some((r) => r.t.length > 40);

// Marathi: the translation is stored as aligned paragraphs (chapterBlocks), so the English shown beside it uses the same paragraphs.
const marathi = marathiOf(vol);
const translated = mr && rows.length > 0 && rows.every((r) => marathi.pages.has(r.p));
const aligned = translated ? chapterBlocks(rows) : [];
const reviewed = translated && rows.every((r) => /reviewed: yes/.test(marathi.pages.get(r.p)?.by || ''));
const summary = translated ? marathi.summaries[leaf.slug] : undefined;
const pagesShown = rows.map((r, i) => ({
  ...r,
  blocks: translated ? marathi.pages.get(r.p)!.b : formatPage(r.t),
  english: translated ? aligned[i].blocks : [],
}));

const name = (s: string) => titleIn(vol, s, lang);
const chapterTitle = name(leaf.chapter.title);
const partLabel = leaf.chapter.parts.length > 1 ? name(leaf.title) : '';
const labelOf = (l: Leaf) => (l.chapter.parts.length > 1 ? `${name(l.chapter.title)} — ${name(l.title)}` : name(l.chapter.title));
const volLabel = volLabelIn(vol, lang);
const groupName = leaf.chapter.group ? name(leaf.chapter.group) : '';

// Right-hand "On this page": every printed page, with the first heading on it when there is one.
const SMALL = /^(a|an|and|as|at|by|for|from|in|of|on|or|the|to|with)$/;
const tidy = (s: string) => (/[a-z]/.test(s) ? s : s.toLowerCase().replace(/[a-z][a-z'’.]*/g, (w, i) => (i > 0 && SMALL.test(w) ? w : w[0].toUpperCase() + w.slice(1))));
const short = (s: string) => { const x = tidy(s.trim()); return x.length > 44 ? x.slice(0, 42).trim() + '…' : x; };
const outline = pagesShown.filter((r) => r.blocks.length > 0).map((r) => {
  const h = r.blocks.find((b: { type: string }) => b.type === 'h') as { text: string } | undefined;
  return {
    id: `p${r.p}`,
    label: r.n ? t(`Page ${r.n}`, `पृष्ठ ${r.n}`) : t(`PDF page ${r.p}`, `PDF पृष्ठ ${r.p}`),
    sub: h ? short(h.text) : undefined,
  };
});
const here = partLabel ? `${chapterTitle} · ${partLabel}` : chapterTitle;
---
<DocsShell vol={vol} current={leaf.slug} here={here} outline={outline} pdf={`${vol.sourceUrl}#page=${leaf.start}`} title={`${chapterTitle}${partLabel ? ` (${partLabel})` : ''} — ${volLabel}`} description={t(`${leaf.chapter.title}, from ${vol.label} of Dr. Babasaheb Ambedkar: Writings and Speeches — the full text, page by page.`, translated ? `${chapterTitle} — डॉ. बाबासाहेब आंबेडकर: लेखन आणि भाषणे, ${volLabel}. पान न् पान मराठी अनुवाद, मूळ इंग्रजीसह.` : `${chapterTitle} — डॉ. बाबासाहेब आंबेडकर: लेखन आणि भाषणे, ${volLabel}. पान न् पान संपूर्ण मजकूर.`)}>
  <article
    class="docs-article"
    data-pagefind-body={hasText ? '' : undefined}
    data-pagefind-filter="collection:Writings and Speeches"
    data-pagefind-meta={`title:${chapterTitle}${partLabel ? ` · ${partLabel}` : ''} — ${volLabel}`}
  >
    <span hidden data-pagefind-filter="volume">{vol.label}</span>
    <span hidden data-pagefind-meta="pdf">{vol.sourceUrl}</span>
    <span hidden data-pagefind-meta="volumeTitle">{vol.title}</span>

    <header class="docs-head" data-pagefind-ignore>
      <nav class="docs-crumbs" aria-label={t('Breadcrumb', 'मार्ग')}>
        <a href={url('/library/')}>{t('Library', 'ग्रंथालय')}</a><span aria-hidden="true">›</span>
        <a href={url(`/library/${vol.id}/`)}>{volLabel}</a>
        {groupName && <><span aria-hidden="true">›</span><span class="dc-here">{groupName}</span></>}
      </nav>
      <h1>{chapterTitle}</h1>
      {mr && chapterTitle !== leaf.chapter.title && <p class="docs-orig-title"><span>मूळ इंग्रजी शीर्षक:</span> <span lang="en">{leaf.chapter.title}</span></p>}
      <p class="docs-meta">
        {partLabel && <span class="docs-part">{partLabel}</span>}
        <span>{t(`PDF pages ${leaf.start}–${leaf.end}`, `PDF पृष्ठे ${leaf.start}–${leaf.end}`)}</span>
        <span>{t(`Writings and Speeches, ${vol.label}`, `लेखन आणि भाषणे, ${volLabel}`)}</span>
      </p>
      <div class="rm-switch" role="radiogroup" aria-label={t('Reading mode', 'वाचन पद्धत')} data-rm>
        <button type="button" role="radio" aria-checked="true" data-mode="text">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 10h14M5 14h14M5 18h9" /></svg>{t('Text', 'मजकूर')}
        </button>
        <button type="button" role="radio" aria-checked="false" data-mode="split">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="1" /><path d="M12 4v16" /></svg>{t('Side by side', 'शेजारी शेजारी')}
        </button>
        <button type="button" role="radio" aria-checked="false" data-mode="pdf">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7z" /><path d="M14 3v5h5" /></svg>{t('Official PDF', 'मूळ PDF')}
        </button>
      </div>
    </header>

    <section class="rm-pdf" data-rm-pdf data-src={url(`/pdf/${vol.id}/${leaf.slug}.pdf`)} data-start={leaf.start} data-end={leaf.end} data-pagefind-ignore aria-label={t('Official PDF', 'मूळ PDF')}>
      <div class="rm-pdf-bar">
        <span class="rm-pdf-src">{t(`Original · pp. ${leaf.start}–${leaf.end}`, `मूळ · पृ. ${leaf.start}–${leaf.end}`)}</span>
        <span class="rm-zoom">
          <button type="button" data-rm-zoom="-1" aria-label={t('Zoom out', 'लहान करा')}>−</button>
          <button type="button" data-rm-zoom="0" aria-label={t('Fit', 'बसवा')}>{t('Fit', 'बसवा')}</button>
          <button type="button" data-rm-zoom="1" aria-label={t('Zoom in', 'मोठे करा')}>+</button>
        </span>
        <a href={url(`/pdf/${vol.id}/${leaf.slug}.pdf`)} target="_blank" rel="noopener" data-rm-open>{t('Open in a new tab ↗', 'नवीन टॅबमध्ये उघडा ↗')}</a>
      </div>
      <div class="rm-pages" data-rm-pages tabindex="0" data-l-page={t('PDF page', 'PDF पृष्ठ')} data-l-fail={t('The PDF could not be shown here. Use “Open in a new tab”.', 'PDF येथे दाखवता आले नाही. “नवीन टॅबमध्ये उघडा” वापरा.')}>
        <p class="rm-loading">{t('Loading the original pages…', 'मूळ पाने उघडत आहे…')}</p>
      </div>
    </section>

    {hasText && (
      <div class="ra-anchor" data-ra-anchor data-pagefind-ignore>
      <div class="read-aloud" data-read-aloud hidden
        data-l-play={t('Listen', 'ऐका')} data-l-resume={t('Resume', 'पुढे ऐका')} data-l-pause={t('Pause', 'थांबवा')}
        data-l-novoice={t('No Marathi voice on this device, so a Hindi voice is reading. For a better Marathi voice, use Microsoft Edge or Chrome on Android, or add a Marathi voice in your device settings.', 'या उपकरणावर मराठी आवाज नाही, म्हणून हिंदी आवाज वाचत आहे. चांगल्या मराठी आवाजासाठी Microsoft Edge किंवा Android वरील Chrome वापरा, किंवा उपकरणाच्या सेटिंग्जमध्ये मराठी आवाज जोडा.')}
        data-l-none={t('This device has no voice for this language. You can add one in your device settings.', 'या उपकरणावर या भाषेसाठी आवाज नाही. उपकरणाच्या सेटिंग्जमध्ये तो जोडता येईल.')}>
        <button type="button" class="ra-play" data-ra-play aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="ra-i-listen" d="M4 14v-2a8 8 0 0 1 16 0v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <rect class="ra-i-listen" x="3" y="13" width="5" height="7" rx="1.5" />
            <rect class="ra-i-listen" x="16" y="13" width="5" height="7" rx="1.5" />
            <path class="ra-i-pause" d="M7 5h4v14H7zM13 5h4v14h-4z" />
          </svg>
          <span class="ra-label">{t('Listen', 'ऐका')}</span>
        </button>
        <button type="button" class="ra-stop" data-ra-stop hidden aria-label={t('Stop', 'थांबवा')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6z" /></svg></button>
        <label class="ra-rate"><span class="visually-hidden">{t('Listening speed', 'ऐकण्याचा वेग')}</span>
          <select data-ra-rate>
            <option value="0.8">0.8×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option>
          </select>
        </label>
        <label class="ra-voice"><span class="visually-hidden">{t('Voice', 'आवाज')}</span>
          <select data-ra-voice></select>
        </label>
        <p class="ra-msg" data-ra-msg hidden></p>
      </div>
      </div>
    )}

    {mr && translated && (
      <div class="mr-translation-note" data-pagefind-ignore>
        <p><strong>मराठी अनुवाद.</strong> {reviewed
          ? 'हा अनुवाद मराठी अभ्यासकांनी मूळ इंग्रजीशी तपासला आहे.'
          : 'हा अनुवाद AI (Claude) च्या मदतीने, आमच्या सार्वजनिक अनुवाद-मार्गदर्शिकेनुसार केलेला मसुदा आहे; अजून अभ्यासकांनी तपासलेला नाही.'} प्रत्येक परिच्छेदाचा मूळ इंग्रजी मजकूर पानाखालील “मूळ इंग्रजी” मध्ये आणि मूळ PDF चे पान उजवीकडील दुव्यावर पाहा. <a href={url('/contribute/#translation')}>अनुवादात चूक कळवा</a>.</p>
      </div>
    )}
    {mr && !translated && (
      <p class="mr-note" data-pagefind-ignore>या प्रकरणाचा मराठी अनुवाद अजून झालेला नाही. खाली मूळ इंग्रजी मजकूर (अधिकृत PDF मधून जसाच्या तसा) दिला आहे.</p>
    )}
    {summary && (
      <aside class="in-simple" data-pagefind-ignore>
        <h2>सोप्या शब्दांत</h2>
        <p>{summary}</p>
        <p class="muted">हा सारांश समजण्यासाठी आहे; हा बाबासाहेबांचा मूळ मजकूर नाही.</p>
      </aside>
    )}

    {pagesShown.map((r) => (
      <section class="docs-page">
        <div class="page-mark">
          <h2 id={`p${r.p}`}>{r.n ? t(`Page ${r.n}`, `पृष्ठ ${r.n}`) : t(`PDF page ${r.p}`, `PDF पृष्ठ ${r.p}`)}</h2>
          <a href={`${vol.sourceUrl}#page=${r.p}`} target="_blank" rel="noopener noreferrer" data-pagefind-ignore title={t('Compare with the original PDF page', 'मूळ PDF पानाशी तुलना करा')}>{t(`PDF p. ${r.p} ↗`, `PDF पृ. ${r.p} ↗`)}</a>
        </div>
        <div class="reader" lang={translated ? 'mr' : 'en'}>
          {r.blocks.length ? r.blocks.map((b) => (b.type === 'h' ? <h3>{b.text}</h3> : b.type === 'fn' ? <p class="fn">{b.text}</p> : <p>{b.text}</p>)) : <p class="muted">{t('(This page has no text — it may be blank or an image.)', '(या पानावर मजकूर नाही — ते कोरे किंवा चित्राचे पान असू शकते.)')}</p>}
        </div>
        {translated && r.english.length > 0 && (
          <details class="orig" data-pagefind-ignore>
            <summary>मूळ इंग्रजी</summary>
            <div class="reader reader-en" lang="en">{r.english.map((b) => (b.type === 'h' ? <h3>{b.text}</h3> : b.type === 'fn' ? <p class="fn">{b.text}</p> : <p>{b.text}</p>))}</div>
          </details>
        )}
      </section>
    ))}

    <p class="docs-note" data-pagefind-ignore>{translated
      ? 'मूळ इंग्रजी मजकूर भारत सरकारने प्रकाशित केलेल्या अधिकृत PDF मधून शब्दशः घेतला आहे. पानांच्या सीमेवर तुटलेला परिच्छेद अनुवादात तो सुरू होणाऱ्या पानावर पूर्ण दिला आहे. उद्धृत करण्यापूर्वी मूळ पान तपासा.'
      : t('Text taken word for word from the official PDF published by the Government of India. Line breaks have been joined into paragraphs; automatic extraction can still leave small errors, so check the original page before quoting.', 'मजकूर भारत सरकारने प्रकाशित केलेल्या अधिकृत PDF मधून शब्दशः घेतला आहे. ओळी जोडून परिच्छेद केले आहेत; स्वयंचलित प्रक्रियेत लहान चुका राहू शकतात, म्हणून उद्धृत करण्यापूर्वी मूळ पान तपासा.')}</p>

    <nav class="docs-pager" aria-label={t('Chapters', 'प्रकरणे')} data-pagefind-ignore>
      {prev ? <a href={url(`/library/${vol.id}/${prev.slug}/`)}><small>{t('← Previous', '← मागील')}</small><strong>{labelOf(prev)}</strong></a> : <span></span>}
      {next && <a class="next" href={url(`/library/${vol.id}/${next.slug}/`)}><small>{t('Next →', 'पुढील →')}</small><strong>{labelOf(next)}</strong></a>}
    </nav>
  </article>
  <script is:inline>
    (function () {
      /* Reading modes on wide screens: the text; the text and the original pages side by side, scrolling together;
         or the original pages alone, one whole page at a time. */
      var docs = document.querySelector('.docs'), sw = document.querySelector('[data-rm]'), pane = document.querySelector('[data-rm-pdf]');
      if (!docs || !sw || !pane) return;
      var box = pane.querySelector('[data-rm-pages]'), open = pane.querySelector('[data-rm-open]');
      var src = pane.dataset.src, start = parseInt(pane.dataset.start, 10), end = parseInt(pane.dataset.end, 10), wide = window.matchMedia('(min-width: 1024px)');
      var secs = Array.prototype.slice.call(document.querySelectorAll('.docs-article .docs-page'));
      var secOf = {}; secs.forEach(function (s) { var h = s.querySelector('h2[id^="p"]'); if (h) secOf[parseInt(h.id.slice(1), 10)] = s; });
      var mode = 'text';
      try { mode = localStorage.getItem('read-mode') || 'text'; } catch (e) {}
      var cur = function () { return docs.getAttribute('data-mode') || 'text'; };

      // The original pages, drawn with pdf.js from this site's copy of the chapter (loaded only when asked for).
      var PDFJS = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/';
      var doc = null, loading = null, zoom = 1, slots = [], ratio = 1.5;
      var loadLib = function () {
        if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
        return new Promise(function (ok, bad) {
          var sc = document.createElement('script'); sc.src = PDFJS + 'pdf.min.js';
          sc.onload = function () { window.pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS + 'pdf.worker.min.js'; ok(window.pdfjsLib); };
          sc.onerror = bad; document.head.appendChild(sc);
        });
      };
      var draw = function (slot) {
        if (slot.drawn || !doc) return;
        slot.drawn = true;
        doc.getPage(slot.n).then(function (page) {
          var base = page.getViewport({ scale: 1 });
          var vp = page.getViewport({ scale: (slot.el.clientWidth / base.width) * (window.devicePixelRatio || 1) });
          var c = document.createElement('canvas'); c.width = vp.width; c.height = vp.height;
          return page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise.then(function () {
            var old = slot.el.querySelector('canvas'); if (old) old.remove();
            slot.el.appendChild(c);
          });
        }).catch(function () { slot.drawn = false; });
      };
      var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) draw(slots[e.target.dataset.i]); });
      }, { root: box, rootMargin: '1200px 0px' }) : null;
      // Page size: side by side fits the pane's width; the PDF view fits one whole page in the screen's height.
      var layout = function () {
        if (!slots.length) return;
        var cs = getComputedStyle(box);
        var w = box.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        var h = box.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
        var fit = cur() === 'pdf' ? Math.min(w, h / ratio) : w;
        box.style.setProperty('--rm-w', Math.round(fit * zoom) + 'px');
        slots.forEach(function (s) { s.drawn = false; if (io) { io.unobserve(s.el); io.observe(s.el); } else draw(s); });
      };
      var ensure = function () {
        if (loading) return loading;
        loading = loadLib().then(function (lib) { return lib.getDocument(src).promise; }).then(function (d) {
          doc = d; box.innerHTML = '';
          return d.getPage(1).then(function (p1) {
            var vp = p1.getViewport({ scale: 1 }); ratio = vp.height / vp.width;
            for (var i = 1; i <= d.numPages; i++) {
              var el = document.createElement('figure'); el.className = 'rm-page'; el.dataset.i = i - 1;
              el.style.aspectRatio = vp.width + ' / ' + vp.height;
              var cap = document.createElement('figcaption'); cap.textContent = box.dataset.lPage + ' ' + (start + i - 1);
              el.appendChild(cap); box.appendChild(el); slots.push({ el: el, n: i, drawn: false });
            }
            layout();
          });
        }).catch(function () { box.innerHTML = '<p class="rm-loading">' + box.dataset.lFail + '</p>'; });
        return loading;
      };
      var gotoPage = function (p) {
        var s = slots[Math.min(Math.max(p - start, 0), slots.length - 1)];
        if (s) box.scrollTop = s.el.offsetTop - 26;
      };

      // Side by side: both sides move together, page for page, from whichever side the reader is scrolling.
      var lead = 'text', busy = false;
      var anchorT = function () { return window.innerHeight * 0.3; };
      var anchorP = function () { return box.clientHeight * 0.3; };
      var fromText = function () {
        if (!slots.length) return;
        var a = anchorT(), sec = null;
        for (var i = 0; i < secs.length; i++) { if (secs[i].getBoundingClientRect().top <= a) sec = secs[i]; else break; }
        sec = sec || secs[0]; if (!sec) return;
        var r = sec.getBoundingClientRect(), f = Math.min(1, Math.max(0, (a - r.top) / (r.height || 1)));
        var p = parseInt(sec.querySelector('h2').id.slice(1), 10), s = slots[p - start]; if (!s) return;
        box.scrollTo({ top: s.el.offsetTop + f * s.el.offsetHeight - anchorP(), behavior: 'instant' });
      };
      var fromPdf = function () {
        if (!slots.length) return;
        var y = box.scrollTop + anchorP(), s = slots[0];
        for (var i = 0; i < slots.length; i++) { if (slots[i].el.offsetTop <= y) s = slots[i]; else break; }
        var f = Math.min(1, Math.max(0, (y - s.el.offsetTop) / s.el.offsetHeight));
        var sec = secOf[start + s.n - 1]; if (!sec) return;
        var r = sec.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + r.top + f * r.height - anchorT(), behavior: 'instant' });
      };
      // one update per frame, always with the latest position (the side being scrolled leads, so the other never echoes back)
      var sync = function (fn) {
        if (busy || cur() !== 'split') return;
        busy = true; requestAnimationFrame(function () { busy = false; fn(); });
      };
      ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach(function (ev) {
        box.addEventListener(ev, function () { lead = 'pdf'; }, { passive: true });
        window.addEventListener(ev, function (e) { if (!box.contains(e.target)) lead = 'text'; }, { passive: true, capture: true });
      });
      window.addEventListener('scroll', function () { if (lead === 'text') sync(fromText); }, { passive: true });
      box.addEventListener('scroll', function () { if (lead === 'pdf') sync(fromPdf); }, { passive: true });

      var apply = function (m, save) {
        var was = cur(), from = was === 'text' ? (function () {
          var a = anchorT(), p = start;
          secs.forEach(function (s) { if (s.getBoundingClientRect().top <= a) p = parseInt(s.querySelector('h2').id.slice(1), 10); });
          return p;
        })() : 0;
        mode = m;
        docs.setAttribute('data-mode', wide.matches ? m : 'text');
        document.documentElement.classList.toggle('rm-lock', wide.matches && m === 'pdf');
