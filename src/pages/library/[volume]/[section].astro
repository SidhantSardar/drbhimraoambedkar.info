  <script is:inline>
    (function () {
      /* Listen: text to speech with the voices on the reader's own device (Web Speech API). Nothing is sent anywhere. */
      var bar = document.querySelector('[data-read-aloud]'), anchor = document.querySelector('[data-ra-anchor]');
      if (!bar || !('speechSynthesis' in window) || !window.SpeechSynthesisUtterance) return;
      var synth = window.speechSynthesis;
      var playBtn = bar.querySelector('[data-ra-play]'), stopBtn = bar.querySelector('[data-ra-stop]');
      var rateSel = bar.querySelector('[data-ra-rate]'), voiceSel = bar.querySelector('[data-ra-voice]'), msg = bar.querySelector('[data-ra-msg]');
      var label = bar.querySelector('.ra-label');
      bar.hidden = false;

      var blocks = Array.prototype.slice.call(document.querySelectorAll('.docs-article .reader:not(.reader-en) > p:not(.fn):not(.muted), .docs-article .reader:not(.reader-en) > h3'));
      if (!blocks.length) { anchor.hidden = true; return; }
      var lang = (blocks[0].closest('.reader').getAttribute('lang') || 'en');
      var KEY = 'listen-voice-' + lang;

      // rank voices: natural / neural / online voices first, then Indian locales
      var score = function (v) {
        var n = (v.name || '') + ' ' + (v.voiceURI || ''), s = 0;
        if (/natural|neural|online|premium|enhanced|wavenet|studio/i.test(n)) s += 20;
        // a male voice first: Ambedkar's words in a man's voice (known male voices in Edge, macOS/iOS, Windows, Google)
        if (/\b(prabhat|manohar|madhur|rishi|ravi|hemant|aaron|daniel|arthur|male)\b/i.test(n)) s += 30;
        if (/\b(neerja|aarohi|swara|lekha|kalpana|heera|veena|female|samantha|karen|moira|tessa)\b/i.test(n)) s -= 15;
        if (/google/i.test(n)) s += 8;
        if (/-IN$/i.test(v.lang) || /_IN$/i.test(v.lang)) s += 5;
        if (v.localService === false) s += 2;
        return s;
      };
      var voices = [], voice = null, fallback = false;
      var load = function () {
        var all = synth.getVoices(); if (!all.length) return;
        var NOVELTY = /^(albert|bad news|bahh|bells|boing|bubbles|cellos|good news|jester|organ|superstar|trinoids|whisper|wobble|zarvox|junior|ralph|fred|kathy|grandma|grandpa|eddy|flo|reed|rocko|sandy|shelley)\b/i;
        var mine = all.filter(function (v) { return new RegExp('^' + lang, 'i').test(v.lang) && !NOVELTY.test(v.name); });
        fallback = false;
        if (!mine.length && lang === 'mr') { mine = all.filter(function (v) { return /^hi/i.test(v.lang); }); fallback = mine.length > 0; }
        voices = mine.sort(function (a, b) { return score(b) - score(a); });
        var saved = null; try { saved = localStorage.getItem(KEY); } catch (e) {}
        voice = voices.filter(function (v) { return v.voiceURI === saved; })[0] || voices[0] || null;
        voiceSel.innerHTML = '';
        voices.slice(0, 12).forEach(function (v) {
          var o = document.createElement('option'); o.value = v.voiceURI;
          o.textContent = v.name.replace(/^(Microsoft|Google)\s+/, '').replace(/\s*\(.*?\)\s*/g, ' ').replace(/\s+-\s+.*$/, '').trim() + (score(v) >= 20 ? ' ★' : '');
          if (voice && v.voiceURI === voice.voiceURI) o.selected = true;
          voiceSel.appendChild(o);
        });
        voiceSel.parentNode.hidden = voices.length < 2;
      };
      load();
      if (synth.onvoiceschanged !== undefined) synth.addEventListener('voiceschanged', load);
      voiceSel.addEventListener('change', function () {
        voice = voices.filter(function (v) { return v.voiceURI === voiceSel.value; })[0] || voice;
        try { localStorage.setItem(KEY, voiceSel.value); } catch (e) {}
        if (state === 'playing') { synth.cancel(); qi = Math.max(0, qi - 1); setTimeout(speakNext, 60); }
      });

      var chunks = function (text) {
        var parts = text.match(/[^.!?।॥]+[.!?।॥]*["”’)\]]*\s*/g) || [text], out = [], cur = '';
        parts.forEach(function (p) { if ((cur + p).length > 220 && cur) { out.push(cur); cur = p; } else cur += p; });
        if (cur.trim()) out.push(cur);
        return out;
      };
      var idx = 0, state = 'idle', queue = [], qi = 0;
      var mark = function (el) {
        blocks.forEach(function (b) { b.classList.remove('ra-now'); });
        if (!el) return;
        el.classList.add('ra-now');
        var r = el.getBoundingClientRect();
        if (r.top < 120 || r.bottom > innerHeight - 40) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };
      var setUI = function () {
        bar.classList.toggle('playing', state === 'playing');
        bar.classList.toggle('active', state !== 'idle');
        stopBtn.hidden = state === 'idle';
        var l = state === 'playing' ? bar.dataset.lPause : state === 'paused' ? bar.dataset.lResume : bar.dataset.lPlay;
        label.textContent = l; playBtn.setAttribute('aria-label', l);
        playBtn.setAttribute('aria-pressed', state === 'playing' ? 'true' : 'false');
      };
      var speakNext = function () {
        if (state !== 'playing') return;
        if (qi >= queue.length) {
          idx++; if (idx >= blocks.length) { stop(); return; }
          queue = chunks(blocks[idx].textContent); qi = 0; mark(blocks[idx]);
        }
        var u = new SpeechSynthesisUtterance(queue[qi++]);
