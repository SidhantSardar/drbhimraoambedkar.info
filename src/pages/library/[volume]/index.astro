---
import DocsShell from '../../../components/DocsShell.astro';
import { volumes, tocOf, firstChapter, coverOf, type Volume } from '../../../lib/library';
import { url } from '../../../lib/site';

export function getStaticPaths() {
  return volumes().map((vol) => ({ params: { volume: vol.id }, props: { vol } }));
}
const { vol } = Astro.props as { vol: Volume };
const chapters = tocOf(vol);
const start = firstChapter(vol);
---
<DocsShell vol={vol} title={`${vol.label} — ${vol.title}`} description={`Read ${vol.label} of Dr. Babasaheb Ambedkar: Writings and Speeches online — ${vol.title}.`}>
  <div class="docs-overview">
    <figure class="book-cover large"><img src={url(coverOf(vol))} alt={`Cover of ${vol.label}`} width="360" height="560" /></figure>
    <div>
      <span class="eyebrow">Dr. Babasaheb Ambedkar: Writings and Speeches</span>
      <h1>{vol.label}</h1>
      <p class="lede">{vol.title}</p>
      <p class="muted">{chapters.filter((c) => c.title !== 'Front matter').length} chapters · {vol.pages} pages</p>
      <div class="btn-row" style="margin:22px 0 10px">
        {start && <a class="btn btn-primary btn-beam" href={url(`/library/${vol.id}/${start.slug}/`)}><span>Start reading →</span></a>}
        <a class="btn btn-ghost" href={url(`/ask/?volume=${encodeURIComponent(vol.label)}`)}>Search this volume</a>
      </div>
      <p class="source-link">Source: <a href={vol.officialUrl} target="_blank" rel="noopener noreferrer">official PDF, Government of India ↗</a></p>
    </div>
  </div>
  <h2 class="docs-toc-title">Contents</h2>
  <ol class="docs-toc">
    {chapters.map((c, i) => (
      <li>
        {c.group && c.group !== chapters[i - 1]?.group && <span class="g">{c.group}</span>}
        <a href={url(`/library/${vol.id}/${c.parts[0].slug}/`)}>{c.title}</a>
        <span class="pp">pp. {c.start}–{c.end}</span>
      </li>
    ))}
  </ol>
</DocsShell>
