---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chakra from '../../components/Chakra.astro';
import Comments from '../../components/Comments.astro';
import { url } from '../../lib/site';
import { getLang, translator } from '../../i18n';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const lang = getLang(Astro);
const t = translator(lang);
const english = Astro.props.post;
const post = lang === 'mr' ? (await getCollection('blogMr')).find((m) => m.id === english.id) || english : english;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString(lang === 'mr' ? 'mr-IN' : 'en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description} image={post.data.image ? url(post.data.image) : undefined} progress>
  <article data-pagefind-body data-pagefind-filter={t('collection:Blog', 'collection:ब्लॉग')}>
    <header class="story-hero">
      <Chakra class="chakra-bg" />
      <div class="narrow story-hero-inner">
        <p data-pagefind-ignore><a href={url('/blog/')} class="muted">{t('Blog', 'ब्लॉग')}</a></p>
        <h1>{post.data.title}</h1>
        <p class="subtitle">{post.data.description}</p>
        <p class="muted" style="font-size:0.9rem;margin:0">{date} · {post.data.author}</p>
      </div>
    </header>
    <div class="narrow">
      {lang === 'mr' && post === english && <p class="mr-note" style="margin-top:24px" data-pagefind-ignore>या लेखाचा मराठी अनुवाद तयार होत आहे. तोपर्यंत मूळ इंग्रजी लेख येथे दिला आहे.</p>}
      <div class="prose" style="margin-top:32px"><Content /></div>
      <div data-pagefind-ignore><Comments term={`blog/${english.id}`} /></div>
    </div>
  </article>
</Base>
