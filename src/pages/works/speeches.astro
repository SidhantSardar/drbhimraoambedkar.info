---
import Base from '../../layouts/Base.astro';
import Chakra from '../../components/Chakra.astro';
import WorkLinks from '../../components/WorkLinks.astro';
import { loadJSON, type Speech } from '../../lib/data';
import { url } from '../../lib/site';
import { getLang, translator, formatDateIn } from '../../i18n';
import { volumes, coverOf } from '../../lib/library';
import { bawsVolumeId, bawsReaderPath } from '../../lib/sources.mjs';
const vols = volumes();
const bookOf = (b?: { volume?: string; pages?: string; url?: string }) => {
  const vol = b ? vols.find((v) => v.id === bawsVolumeId(b)) : undefined;
  const here = b ? bawsReaderPath(b) : null;
  return vol && here ? { cover: url(coverOf(vol)), read: url(here) } : null;
};
const lang = getLang(Astro);
const t = translator(lang);
const speeches = loadJSON<Speech[]>('speeches', [], lang).sort((a, b) => String(a.date).localeCompare(String(b.date)));
---
<Base title={t('Speeches', 'भाषणे')} description={t('The major speeches of Dr. B. R. Ambedkar — where and when he spoke, what he said, in simple words, with links to the full text.', 'डॉ. बाबासाहेब आंबेडकर यांची महत्त्वाची भाषणे — ते कुठे आणि केव्हा बोलले, काय म्हणाले, सोप्या शब्दांत, संपूर्ण मजकुराच्या दुव्यांसह.')}>
  <section class="hero">
    <Chakra class="chakra-bg" />
    <div class="wrap section-tight">
      <span class="eyebrow">{t('In his own voice', 'त्यांच्याच आवाजात')}</span>
      <h1 style="font-size:var(--step-4)">{t('Speeches', 'भाषणे')}</h1>
      <p class="lede" style="max-width:64ch">{t(`${speeches.length} major speeches — at conferences, in legislatures, in the Constituent Assembly and at great public gatherings — with the key idea of each and a link to the full text.`, `${speeches.length} महत्त्वाची भाषणे — परिषदांमध्ये, कायदेमंडळांत, संविधान सभेत आणि मोठ्या जाहीर सभांमध्ये — प्रत्येकातील मुख्य विचार आणि संपूर्ण मजकुराच्या दुव्यासह.`)}</p>
    </div>
  </section>
  <div class="narrow section-tight">
    <label class="visually-hidden" for="sq">{t('Search speeches', 'भाषणे शोधा')}</label>
    <input class="search-input" id="sq" type="search" placeholder={t('Search speeches by place, year or idea…', 'ठिकाण, वर्ष किंवा विचाराने भाषणे शोधा…')} style="margin-bottom:20px" />
    <ol class="tl-list" id="speeches">
      {speeches.map((s) => (
        <li class:list={['tl-item', { 'has-book': bookOf(s.baws) }]} id={s.id} data-search={[s.title, s.place, s.date, s.occasion, s.summary, s.keyIdea].join(' ').toLowerCase()}>
          {(() => { const bk = bookOf(s.baws); return bk && (
            <a class="book-cover xs" href={bk.read} tabindex="-1" aria-hidden="true"><img src={bk.cover} alt="" width="84" height="126" loading="lazy" decoding="async" /><span class="book-spine"></span></a>
          ); })()}
          <time datetime={s.date}>{s.date ? formatDateIn(s.date, lang) : t('Date unknown', 'तारीख अज्ञात')}{s.place ? ` · ${s.place}` : ''}</time>
          <h3 style="margin:4px 0">{s.title}</h3>
          {s.occasion && <p class="muted" style="margin:0;font-size:0.95rem">{s.occasion}</p>}
          {s.summary && <p>{s.summary}</p>}
          {s.keyIdea && <p style="font-size:0.95rem"><strong>{t('Key idea:', 'मुख्य विचार:')}</strong> {s.keyIdea}</p>}
          <div class="tl-links">
            <WorkLinks baws={s.baws ? [s.baws] : []} online={s.source?.url ? [{ label: s.source.label || t('Full text', 'संपूर्ण मजकूर'), url: s.source.url }] : []} />
            {s.audioOrVideo && <a class="chip" href={s.audioOrVideo} target="_blank" rel="noopener noreferrer">{t('Listen / watch ↗', 'ऐका / पाहा ↗')}</a>}
          </div>
        </li>
      ))}
    </ol>
    {speeches.length === 0 && <p class="notice">{t('The list of speeches is being compiled.', 'भाषणांची यादी तयार केली जात आहे.')}</p>}
    <p style="margin-top:32px"><a href={url('/ask/')}>{t('Search inside every speech and book →', 'प्रत्येक भाषण आणि पुस्तकात शोधा →')}</a></p>
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById('sq');
      q.addEventListener('input', function () {
        var t = q.value.trim().toLowerCase();
        document.querySelectorAll('#speeches > li').forEach(function (li) { li.hidden = t && li.dataset.search.indexOf(t) < 0; });
      });
    })();
  </script>
</Base>
