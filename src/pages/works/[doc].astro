---
// Publishes the long-form research files in research/works/ as readable pages:
// /works/archives/ (physical-archives.md), /works/bibliography/ (bibliography.md)
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chakra from '../../components/Chakra.astro';
import { getLang } from '../../i18n';

export async function getStaticPaths() {
  type Meta = { title: string; eyebrow: string; lede: string };
  const PAGES: Record<string, { file: string; en: Meta; mr: Meta }> = {
    archives: {
      file: 'works/physical-archives',
      en: { title: 'Where the originals are kept', eyebrow: 'Beyond the internet', lede: 'Some of his work has never been put online. Here is what exists only on paper, which library, archive or museum holds it, and how you can see it.' },
      mr: { title: 'मूळ प्रती कुठे जपल्या आहेत', eyebrow: 'इंटरनेटच्या पलीकडे', lede: 'त्यांचे काही कार्य कधीच ऑनलाइन आलेले नाही. फक्त कागदावर काय आहे, ते कोणत्या ग्रंथालयात, संग्रहात किंवा संग्रहालयात आहे आणि ते तुम्ही कसे पाहू शकता, हे येथे दिले आहे.' },
    },
    bibliography: {
      file: 'works/bibliography',
      en: { title: 'Bibliography', eyebrow: 'Complete list', lede: 'All his known writings in one list, grouped by kind, with sources.' },
      mr: { title: 'संदर्भसूची', eyebrow: 'संपूर्ण यादी', lede: 'त्यांचे सर्व ज्ञात लेखन एकाच यादीत, प्रकारानुसार, संदर्भांसह.' },
    },
  };
  const entries = await getCollection('research');
  return Object.keys(PAGES)
    .map((doc) => ({ doc, entry: entries.find((e) => e.id === PAGES[doc].file) }))
    .filter((x) => x.entry)
    .map(({ doc, entry }) => ({ params: { doc }, props: { entry, meta: PAGES[doc] } }));
}
const lang = getLang(Astro);
const { entry: english, meta: both } = Astro.props as any;
const meta = both[lang];
const entry = lang === 'mr' ? (await getCollection('researchMr')).find((e) => e.id === english.id) || english : english;
const { Content } = await render(entry);
---
<Base title={meta.title} description={meta.lede}>
  <section class="hero">
    <Chakra class="chakra-bg" />
    <div class="wrap section-tight">
      <span class="eyebrow">{meta.eyebrow}</span>
      <h1 style="font-size:var(--step-4)">{meta.title}</h1>
      <p class="lede" style="max-width:64ch">{meta.lede}</p>
    </div>
  </section>
  <article class="narrow section-tight prose" data-pagefind-body data-pagefind-filter={lang === 'mr' ? 'collection:संशोधन' : 'collection:Research'}>
    {lang === 'mr' && entry === english && <p class="mr-note" data-pagefind-ignore>या पानाचा मराठी अनुवाद तयार होत आहे. तोपर्यंत मूळ इंग्रजी मजकूर येथे दिला आहे.</p>}
    <Content />
  </article>
</Base>
